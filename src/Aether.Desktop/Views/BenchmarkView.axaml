<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             xmlns:models="using:Aether.Core.Models"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Aether.Desktop.Views.BenchmarkView"
             x:DataType="vm:BenchmarkViewModel">
    <Grid x:Name="Root"
          Margin="24"
          ColumnDefinitions="260,340,*"
          RowDefinitions="Auto,*"
          ColumnSpacing="16"
          RowSpacing="14">

        <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Benchmarks" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.55" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                <TextBlock Text="Suites" FontWeight="SemiBold" />
                <ListBox Grid.Row="1"
                         MaxHeight="340"
                         ItemsSource="{Binding Suites}"
                         SelectedItem="{Binding SelectedSuite}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:BenchmarkSuite">
                            <StackPanel Spacing="2" Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.55" />
                                <TextBlock Text="{Binding Cases.Count, StringFormat={}{0} cases}"
                                           FontSize="11"
                                           Opacity="0.4" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="Run history"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Export All"
                                Command="{Binding ExportAllRunsCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Export all saved benchmark runs to the data root (per-run files)." />
                            <Button Content="Clear"
                                Command="{Binding ClearRunHistoryCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Deletes all saved benchmark runs after confirmation. Export any runs you want to keep first." />
                        </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3"
                           Text="No runs yet. Pick a suite and model above, then click Run."
                           FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                           IsVisible="{Binding !HasRuns}" />
                <ListBox Grid.Row="3"
                         MaxHeight="180"
                         IsVisible="{Binding HasRuns}"
                         ItemsSource="{Binding Runs}"
                         SelectedItem="{Binding SelectedRun}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:BenchmarkRunViewModel">
                            <Border Padding="6" Margin="0,4" CornerRadius="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.55" />
                                        <TextBlock Text="{Binding Started}" FontSize="10" Opacity="0.35" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="ℹ" Padding="6" MinWidth="32" Command="{Binding #Root.DataContext.ShowRunInfoCommand}" CommandParameter="{Binding .}" ToolTip.Tip="Show test details" />
                                        <Button Content="Rerun" Command="{Binding #Root.DataContext.RerunCommand}" CommandParameter="{Binding .}" />
                                        <Button Content="Export" Command="{Binding #Root.DataContext.ExportRunCommand}" CommandParameter="{Binding .}" />
                                        <Button Content="Delete" Command="{Binding #Root.DataContext.DeleteRunCommand}" CommandParameter="{Binding .}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Run Setup" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Model"
                                   FontSize="11"
                                   Opacity="0.55" />
                        <ComboBox ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Shows running provider models plus GGUF files discovered under the configured AI assets root. Selecting a local GGUF starts or restarts the managed chat server for that model.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:LlmModel">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Provider}" Opacity="0.45" FontSize="11" />
                                            <TextBlock Text="{Binding SizeDisplay}" Opacity="0.45" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="10">
                            <StackPanel Spacing="5" Width="120">
                                <TextBlock Text="Temperature" FontSize="11" Opacity="0.55" />
                                <NumericUpDown Value="{Binding Temperature}"
                                               Minimum="0"
                                               Maximum="2"
                                               Increment="0.1"
                                               FormatString="F1"
                                               HorizontalAlignment="Stretch"
                                               ToolTip.Tip="Sampling temperature used for every suite in this run. Lower is more repeatable; higher is more creative." />
                            </StackPanel>
                            <StackPanel Spacing="5" Width="130">
                                <TextBlock Text="Timeout seconds" FontSize="11" Opacity="0.55" />
                                <NumericUpDown Value="{Binding TimeoutSeconds}"
                                               Minimum="10"
                                               Maximum="900"
                                               Increment="10"
                                               HorizontalAlignment="Stretch"
                                               ToolTip.Tip="Per-case timeout in seconds. Larger local models may need longer cold-start limits." />
                            </StackPanel>
                            <StackPanel Spacing="5" Width="120">
                                <TextBlock Text="Max cases" FontSize="11" Opacity="0.55" />
                                <NumericUpDown Value="{Binding MaxCases}"
                                               Minimum="0"
                                               Maximum="100"
                                               Increment="1"
                                               HorizontalAlignment="Stretch"
                                               ToolTip.Tip="0 runs every case in each selected suite. Use a small value for a quick smoke pass." />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Run all suites"
                                  IsChecked="{Binding RunAllSuites}"
                                  ToolTip.Tip="When enabled, one click runs every benchmark suite with the selected model. Turn off to run only the highlighted suite." />
                        <Button Content="Benchmark"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                HorizontalAlignment="Left"
                                Padding="16,8"
                                ToolTip.Tip="Starts the managed server for local GGUF selections, then runs the benchmark suite queue." />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="0">
                    <TabControl>
                        <TabItem Header="Rankings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <Border Padding="14" MinWidth="720">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Score = quality on the suite's checks (0-100). Speed and pass rate are shown separately."
                                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasComparableRankings}" />

                                        <TextBlock Text="Run the same suite against two or more models to compare them."
                                                   FontSize="13" Opacity="0.6" TextWrapping="Wrap"
                                                   Margin="0,20,0,0"
                                                   IsVisible="{Binding !HasComparableRankings}" />

                                        <StackPanel Spacing="10" IsVisible="{Binding HasComparableRankings}">
                                            <Grid ColumnDefinitions="34,*,200,90,90,140,110" ColumnSpacing="12" Margin="0,0,0,4">
                                                <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                                <TextBlock Grid.Column="1" Text="Model" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                                <TextBlock Grid.Column="2" Text="Score" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                                <TextBlock Grid.Column="3" Text="Runs" FontWeight="SemiBold" FontSize="11" Opacity="0.6" TextAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="Pass Rate" FontWeight="SemiBold" FontSize="11" Opacity="0.6" TextAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="Speed (tok/s)" FontWeight="SemiBold" FontSize="11" Opacity="0.6" TextAlignment="Right" />
                                                <TextBlock Grid.Column="6" Text="" MinWidth="110" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding RankedRuns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:BenchmarkRunViewModel">
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                HorizontalAlignment="Stretch"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Click for test details"
                                                                Command="{Binding #Root.DataContext.ShowRunInfoCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,10">
                                                                <Grid ColumnDefinitions="34,*,200,90,90,140,110" ColumnSpacing="12">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Title}" FontSize="10" Opacity="0.4" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="180">
                                                                        <ProgressBar Minimum="0" Maximum="100"
                                                                                     Value="{Binding ScorePercent}"
                                                                                     Height="20"
                                                                                     HorizontalAlignment="Stretch" />
                                                                        <TextBlock Text="{Binding Score}"
                                                                                   FontSize="11" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="3" Text="{Binding RunCountLabel}" Opacity="0.6" VerticalAlignment="Center" TextAlignment="Right" MinWidth="90" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding PassRate}" Opacity="0.6" VerticalAlignment="Center" TextAlignment="Right" MinWidth="90" />
                                                                    <TextBlock Grid.Column="5" Text="{Binding Speed}" Opacity="0.6" VerticalAlignment="Center" TextAlignment="Right" MinWidth="140" TextWrapping="Wrap" />
                                                                    <Button Grid.Column="6"
                                                                            Content="Details"
                                                                            Padding="10,6"
                                                                            MinWidth="90"
                                                                            VerticalAlignment="Center"
                                                                            IsEnabled="{Binding HasResults}"
                                                                            ToolTip.Tip="Show test details"
                                                                            Command="{Binding #Root.DataContext.ShowRunInfoCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="All Results">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Padding="14">
                                    <StackPanel Spacing="10">
                                        <ItemsControl ItemsSource="{Binding Runs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:BenchmarkRunViewModel">
                                                    <StackPanel Spacing="8" Margin="0,0,0,12">
                                                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,0,2"
                                                                Padding="0,0,0,8">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" />
                                                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16">
                                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                                        <TextBlock Text="Score" FontSize="10" Opacity="0.5" />
                                                                        <TextBlock Text="{Binding Score}" FontWeight="SemiBold" FontSize="12" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Text="Pass Rate" FontSize="10" Opacity="0.5" />
                                                                        <TextBlock Text="{Binding PassRate}" FontWeight="SemiBold" FontSize="12" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="1">
                                                                        <TextBlock Text="Speed" FontSize="10" Opacity="0.5" />
                                                                        <TextBlock Text="{Binding Speed}" FontSize="11" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3" Spacing="1">
                                                                        <TextBlock Text="Latency" FontSize="10" Opacity="0.5" />
                                                                        <TextBlock Text="{Binding FirstToken}" FontSize="11" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="10" Opacity="0.4" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Insights">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Padding="14">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding InsightsHeader}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Load insights" Command="{Binding LoadInsightsCommand}" IsEnabled="{Binding !IsLoadingInsights}" />
                                        </Grid>

                                        <Border IsVisible="{Binding InsightsBestOverall, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Best overall" FontWeight="SemiBold" FontSize="12" Opacity="0.6" />
                                                <TextBlock Text="{Binding InsightsBestOverall.DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding InsightsBestOverall.QualityLabel, StringFormat='Quality {0}'}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding InsightsBestOverall.SpeedLabel}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{Binding InsightsBestOverall.EvidenceLabel}" FontSize="11" Opacity="0.5" />
                                                <TextBlock Text="{Binding InsightsBestOverall.StaleLabel}" FontSize="11" Foreground="Orange" IsVisible="{Binding InsightsBestOverall.IsStale}" />
                                            </StackPanel>
                                        </Border>

                                        <Border IsVisible="{Binding HasInsightsUsage}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Based on your usage" FontWeight="SemiBold" FontSize="12" Opacity="0.6" />
                                                <ItemsControl ItemsSource="{Binding InsightsUsage}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:UsageInsightViewModel">
                                                            <TextBlock Text="{Binding Sentence}" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding InsightsLeaderboards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:TagLeaderboardViewModel">
                                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" FontSize="13" />
                                                            <ItemsControl ItemsSource="{Binding Ranked}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="vm:ModelAggregateViewModel">
                                                                        <Grid ColumnDefinitions="*,80,90,Auto" ColumnSpacing="10" Margin="0,3">
                                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding QualityLabel}" Opacity="0.7" TextAlignment="Right" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLabel}" Opacity="0.7" TextAlignment="Right" />
                                                                            <Button Grid.Column="3" Content="Re-run" Padding="8,3" FontSize="11"
                                                                                    Command="{Binding #Root.DataContext.RerunFromInsightsCommand}" CommandParameter="{Binding .}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding ComparisonSentences}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,2" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding InsightsCaveats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="{Binding SelectedRun.Title}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding SelectedRun.Summary}" FontSize="12" Opacity="0.55" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Rerun" Command="{Binding RerunCommand}" CommandParameter="{Binding SelectedRun}" />
                    <Button Content="Export" Command="{Binding ExportRunCommand}" CommandParameter="{Binding SelectedRun}" />
                    <Button Content="Delete" Command="{Binding DeleteRunCommand}" CommandParameter="{Binding SelectedRun}" />
                </StackPanel>
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding SelectedResults}"
                         SelectedItem="{Binding SelectedResult}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:BenchmarkResultViewModel">
                            <Border Padding="8,4" BorderThickness="0" Background="Transparent">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Margin="0,5" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Timings}" FontSize="11" Opacity="0.5" />
                                        <TextBlock Text="{Binding Checks}" FontSize="11" Opacity="0.4" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="ℹ"
                                            Padding="8"
                                            MinWidth="32"
                                            MinHeight="32"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="Show test details"
                                            Command="{Binding #Root.DataContext.ShowCaseInfoCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Row="3" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding SelectedResult.Output}"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         Opacity="0.82" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
