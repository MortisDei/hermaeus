<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aether.ViewModels"
        xmlns:views="using:Aether.Desktop.Views"
        x:Class="Aether.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="720" MinHeight="500"
        Width="1280"   Height="820"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">

    <Grid ColumnDefinitions="Auto,*">

        <Border Grid.Column="0" Width="260"
                IsVisible="{Binding IsSidebarOpen}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <views:ConversationListView DataContext="{Binding}" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <Border Grid.Row="0" Padding="8,6"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Button Grid.Column="0" Classes="icon-btn"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle sidebar">
                        <PathIcon Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                                  Width="18" Height="18" />
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="4">

                        <Button Classes="icon-btn" Command="{Binding ShowChatPanelCommand}"
                                ToolTip.Tip="Chat">
                            <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowAgentPanelCommand}"
                                ToolTip.Tip="Agent - local task workbench">
                            <PathIcon Data="M12 2 4 5v6c0 5.55 3.84 9.74 8 11 4.16-1.26 8-5.45 8-11V5l-8-3zm0 2.18L18 6.43V11c0 4.24-2.55 7.51-6 8.82C8.55 18.51 6 15.24 6 11V6.43l6-2.25zM11 7h2v5h-2V7zm0 7h2v2h-2v-2z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowRagPanelCommand}"
                                ToolTip.Tip="RAG - ask your documents">
                            <PathIcon Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowModelsPanelCommand}"
                                ToolTip.Tip="Model management">
                            <PathIcon Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowTasksPanelCommand}"
                                ToolTip.Tip="Tasks and automations">
                            <PathIcon Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-1 14H7v-2h4v2zm6-4H7v-2h10v2zm0-4H7V7h10v2z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowBenchmarksPanelCommand}"
                                ToolTip.Tip="Benchmarks">
                            <PathIcon Data="M3 17h2v-7H3v7zm4 0h2V7H7v10zm4 0h2v-4h-2v4zm4 0h2V4h-2v13zm4 0h2v-9h-2v9z"
                                      Width="17" Height="17" />
                        </Button>

                        <!-- Services / process manager -->
                        <Button Classes="icon-btn" Command="{Binding ShowServicesPanelCommand}"
                                ToolTip.Tip="Services - manage llama-server processes">
                            <Grid>
                                <PathIcon Data="M13 2.05v2.02c3.95.49 7 3.85 7 7.93 0 3.21-1.81 6-4.72 7.28L13 17v5h5l-1.22-1.22C19.91 19.07 22 15.76 22 12c0-5.18-3.95-9.45-9-9.95zM11 2.05C5.95 2.55 2 6.82 2 12c0 3.76 2.09 7.07 5.22 8.78L6 22h5v-5l-2.28 2.28C7.81 18 6 15.21 6 12c0-4.08 3.05-7.44 7-7.93V2.05z"
                                          Width="17" Height="17" />
                                <!-- Running indicator dot - visible when any server is running -->
                                <Ellipse Width="6" Height="6"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,0,-1,-1"
                                         Fill="#4CAF50"
                                         IsVisible="{Binding Services.Servers,
                                             Converter={x:Static views:MainWindow.AnyRunning}}" />
                            </Grid>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowSystemPanelCommand}"
                                ToolTip.Tip="System overview">
                            <PathIcon Data="M4 5h16v10H4V5zm0-2c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h6v2H7v2h10v-2h-3v-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2H4z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowDoctorPanelCommand}"
                                ToolTip.Tip="Aether Doctor">
                            <PathIcon Data="M12 2a5 5 0 0 0-5 5v3H5a1 1 0 0 0-1 1v3h3v6h10v-6h3v-3a1 1 0 0 0-1-1h-2V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 1 1 6 0v3H9zm0 8v-4h6v4H9z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowLogsPanelCommand}"
                                ToolTip.Tip="Runtime logs">
                            <PathIcon Data="M4 6h16v2H4V6zm0 4h16v2H4v-2zm0 4h10v2H4v-2z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowWizardPanelCommand}"
                                ToolTip.Tip="Setup wizard">
                            <PathIcon Data="M12 2 1 7l11 5 9-4.09V17h2V7L12 2zm0 2.18L18 6.5V9l-6 2.73L6 9V6.5l6-2.32zM5 12.18v4.5L12 20l7-3.32v-4.5l-7 3.32-7-3.32z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowSettingsPanelCommand}"
                                ToolTip.Tip="Settings">
                            <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                      Width="17" Height="17" />
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ToggleQuickChatCommand}"
                                ToolTip.Tip="Quick chat">
                            <PathIcon Data="M4 4h16v10H7.17L4 17.17V4zm0-2c-1.1 0-2 .9-2 2v18l6-6h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4z"
                                      Width="17" Height="17" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Chat.ConversationTitle}"
                               IsVisible="{Binding ShowChat}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" Opacity="0.5"
                               FontSize="12" MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding ActiveViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ChatViewModel">
                        <views:ChatView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:AgentViewModel">
                        <views:AgentView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:RagViewModel">
                        <views:RagView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ModelManagementViewModel">
                        <views:ModelManagementView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ServicesViewModel">
                        <views:ServicesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:TasksViewModel">
                        <views:TasksView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BenchmarkViewModel">
                        <views:BenchmarkView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SystemOverviewViewModel">
                        <views:SystemOverviewView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DoctorViewModel">
                        <views:DoctorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LogsViewModel">
                        <views:LogsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SetupWizardViewModel">
                        <views:SetupWizardView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <Border Grid.Row="1"
                    IsVisible="{Binding ShowQuickChat}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="460"
                    MaxHeight="520"
                    Margin="0,0,18,18"
                    Padding="14"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Quick Chat"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="icon-btn"
                                Command="{Binding ToggleQuickChatCommand}"
                                ToolTip.Tip="Close quick chat">
                            <PathIcon Data="M18.3 5.71 12 12l6.3 6.29-1.41 1.41L10.59 13.41 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.29-6.3z"
                                      Width="13" Height="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Chat.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MessageViewModel">
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="110" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Chat.InputText}"
                                 Watermark="Ask quickly..."
                                 Classes="chat-input"
                                 MinHeight="40"
                                 MaxHeight="92" />
                        <Button Grid.Column="1"
                                Command="{Binding Chat.SendCommand}"
                                Content="Send"
                                Padding="14,8"
                                CornerRadius="8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,58,18,0"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToastViewModel">
                    <Border Width="360"
                            CornerRadius="8"
                            Padding="14"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Opacity="1">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Opacity="0.98" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding KindLabel}"
                                           FontSize="10"
                                           Opacity="0.7"
                                           Margin="8,1,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="12"
                                       Opacity="0.9"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
