<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.ConversationListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- ── Top actions ────────────────────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,8,0,4">
            <Button Classes="sidebar-new" Command="{Binding NewConversationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="15" Height="15" />
                    <TextBlock Text="New Chat" FontSize="13" />
                </StackPanel>
            </Button>

            <Border Margin="8,2" CornerRadius="6"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery}"
                             Watermark="Search…"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,6" FontSize="13" />
                    <PathIcon Grid.Column="1"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Width="14" Height="14" Margin="0,0,8,0" Opacity="0.4" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ── Conversations ──────────────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="ConvList"
                     ItemsSource="{Binding Conversations}"
                     Background="Transparent"
                     Padding="4,0"
                     SelectionMode="Single"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="0,1" />
                    </ControlTheme>
                </ListBox.ItemContainerTheme>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ConversationItemViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBox Text="{Binding Title, Mode=TwoWay}"
                                         FontSize="13"
                                         MaxWidth="175"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         Margin="-2,-3,0,-1"
                                         LostFocus="OnTitleLostFocus"
                                         KeyDown="OnTitleKeyDown" />
                                <TextBlock Text="{Binding TimeDisplay}"
                                           FontSize="11"
                                           Opacity="0.45" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="icon-btn"
                                    Command="{Binding $parent[ListBox].DataContext.DeleteConversationCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Delete"
                                    Opacity="0.5"
                                    x:Name="DelBtn">
                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                          Width="13" Height="13" Opacity="0.55" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>
