<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.SettingsLocalApiSectionView"
             x:DataType="vm:LocalApiSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <TextBlock Text="Local API" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="A loopback-only HTTP host (127.0.0.1) that lets editors and scripts on this machine reuse Aether's chat, memory, and RAG. Off by default; every request requires one of the per-app tokens below."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />

            <CheckBox Content="Enable local API" IsChecked="{Binding Enabled}" />
            <TextBlock Text="{Binding ProcessStatusLabel, StringFormat='Host status: {0}'}" FontSize="11" Opacity="0.6" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Port" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Width="140" />
            </StackPanel>

            <TextBlock Text="Tokens" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Tokens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LocalApiTokenRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay, StringFormat='created {0}'}"
                                       FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Content="Revoke" Padding="8,4" FontSize="11"
                                    Command="{Binding $parent[ItemsControl].DataContext.RevokeTokenCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No tokens configured yet." FontSize="12" Opacity="0.5"
                       IsVisible="{Binding !Tokens.Count}" />

            <StackPanel Spacing="6">
                <TextBox Text="{Binding NewTokenName}" Watermark="Name this token (e.g. VS Code extension)" CornerRadius="6" Padding="10,6" />
                <TextBox Text="{Binding NewTokenValue}"
                         Watermark="Generate a token, then Add"
                         PasswordChar="*"
                         RevealPassword="False"
                         CornerRadius="6"
                         Padding="10,6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Generate token" Command="{Binding GenerateTokenCommand}" Padding="12,6" CornerRadius="6" />
                    <Button Content="Add" Command="{Binding AddTokenCommand}" Padding="12,6" CornerRadius="6" />
                </StackPanel>
                <TextBlock Text="{Binding TokenStatus}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
