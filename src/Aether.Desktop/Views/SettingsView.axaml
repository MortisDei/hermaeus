<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer x:Name="PageScroller"
                  Padding="32"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Spacing="20">

            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Settings" Classes="page-title" />
                <TextBlock Text="Tune models, storage, voice and interface defaults for a local-first workspace."
                           Classes="page-subtitle" />
            </StackPanel>

            <WrapPanel x:Name="SettingsCards"
                       Orientation="Horizontal">

            <!-- llama.cpp Chat -->
            <Border Grid.Row="0" Grid.Column="0" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding LlamaCppEnabled}" />
                        <TextBlock Text="llama.cpp" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding LlamaCppBaseUrl}"
                                 Watermark="http://localhost:8080"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OpenAI compatible -->
            <Border Grid.Row="0" Grid.Column="1" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding OpenAiEnabled}" />
                        <TextBlock Text="OpenAI / Compatible API" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto"
                          RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenAiBaseUrl}"
                                 Watermark="https://api.openai.com"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenAiApiKey}"
                                 PasswordChar="*" Watermark="sk-..."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAG Embeddings -->
            <Border Grid.Row="1" Grid.Column="0" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="RAG Embeddings" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="Embed model"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding EmbeddingModel}"
                                 Watermark="nomic-embed-text"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                    <TextBlock Text="Embedding model used for RAG. Managed separately via Services panel."
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Text to speech -->
            <Border Grid.Row="1" Grid.Column="1" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding TtsEnabled}" />
                            <TextBlock Text="XTTS v2" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TtsStatus}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding StartTtsCommand}"
                                IsVisible="{Binding !IsTtsRunning}"
                                Content="Start" FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Grid.Column="1" Command="{Binding StopTtsCommand}"
                                IsVisible="{Binding IsTtsRunning}"
                                Content="Stop" FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Grid.Column="2" Classes="icon-btn"
                                Command="{Binding RefreshTtsVoicesCommand}"
                                ToolTip.Tip="Refresh XTTS voices">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4a8 8 0 0 0-8 8h2.5l-3.5 3.5L-.5 12H2a10 10 0 0 1 17.07-7.07l-1.42 1.42zM6.35 17.65C7.8 19.1 9.79 20 12 20a8 8 0 0 0 8-8h-2.5l3.5-3.5 3.5 3.5H22a10 10 0 0 1-17.07 7.07l1.42-1.42z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TtsServiceUrl}"
                                 Watermark="http://127.0.0.1:8020"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speaker"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding TtsVoices}"
                                  SelectedItem="{Binding TtsSpeaker}"
                                  FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Device"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding TtsDevices}"
                                  SelectedItem="{Binding TtsDevice}"
                                  FontSize="13" />
                        <CheckBox Grid.Row="2" Grid.Column="2"
                                  IsChecked="{Binding TtsPreload}"
                                  Content="Preload"
                                  FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Version"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TtsModelVersion}"
                                 Watermark="2.0.3" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Script"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TtsScriptPath}"
                                 Watermark="/path/to/xtts_api_server.py" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="4" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsScriptCommand}"
                                ToolTip.Tip="Choose XTTS script">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Output"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TtsOutputDirectory}"
                                 Watermark="Default Aether XTTS folder" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="5" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsOutputCommand}"
                                ToolTip.Tip="Choose XTTS output folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Voices"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TtsVoiceDirectory}"
                                 Watermark="Default Aether voice folder" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="6" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsVoiceDirectoryCommand}"
                                ToolTip.Tip="Choose XTTS voice sample folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Preview"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TtsPreviewText}"
                                 Watermark="Preview sentence" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="7" Grid.Column="2"
                                Command="{Binding PreviewTtsVoiceCommand}"
                                Content="Play" FontSize="12" Padding="10,5" CornerRadius="6" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Clone"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding TtsCloneDisplayName}"
                                 Watermark="Imported voice name" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="8" Grid.Column="2"
                                Command="{Binding ImportTtsVoiceSampleCommand}"
                                Content="Import" FontSize="12" Padding="10,5" CornerRadius="6" />
                    </Grid>
                    <TextBlock Text="Audio is held in memory and piped to the system player; Aether does not keep generated WAV files."
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Grid.Row="2" Grid.Column="0" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Data Storage" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Data folder"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding DataRootDirectory}"
                                 Watermark="Default OS app data folder"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseDataRootCommand}"
                                ToolTip.Tip="Choose data folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <TextBlock Text="New saves use this folder after Save. Move existing data manually if you want to relocate an old library."
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Classes="settings-card" Width="464" Margin="0,0,16,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Defaults" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding Temperature}"
                                       Minimum="0" Maximum="2" Increment="0.1"
                                       FormatString="F1" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max tokens"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding MaxTokens}"
                                       Minimum="256" Maximum="128000" Increment="256"
                                       FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Font size"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding FontSize}"
                                       Minimum="10" Maximum="24" Increment="1"
                                       FontSize="13" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Theme"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  FontSize="13" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Default system prompt" Opacity="0.6" FontSize="13" />
                        <TextBox Text="{Binding DefaultSystemPrompt}"
                                 Watermark="You are a helpful assistant..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="72" FontSize="13"
                                 CornerRadius="6" Padding="10,8" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding CtrlEnterToSend}"
                              Content="Ctrl+Enter to send (Enter inserts newline)"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding ShowQuickChat}"
                              Content="Show compact quick-chat surface"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding StartMinimized}"
                              Content="Start minimized"
                              FontSize="13" />
                </StackPanel>
            </Border>

            </WrapPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding SaveCommand}" Content="Save"
                        FontSize="13" Padding="16,8" CornerRadius="8" />
                <Button Command="{Binding ResetCommand}" Content="Reset"
                        FontSize="13" Padding="16,8" CornerRadius="8" />
                <TextBlock Text="Saved" IsVisible="{Binding IsSaved}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="{Binding SettingsError}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
