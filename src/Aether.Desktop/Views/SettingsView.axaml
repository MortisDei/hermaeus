<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Aether.Core.Models"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer x:Name="PageScroller"
                  Padding="32"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Spacing="20">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Settings" Classes="page-title" />
                    <TextBlock Text="Tune models, storage, voice and interface defaults for a local-first workspace."
                               Classes="page-subtitle" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="Save"
                        FontSize="13" Padding="16,8" CornerRadius="8" />
                <Button Grid.Column="2" Command="{Binding ResetCommand}" Content="Reset"
                        FontSize="13" Padding="16,8" CornerRadius="8" />
            </Grid>

            <Grid x:Name="SettingsCards"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="16">

            <!-- llama.cpp Chat -->
            <Border Grid.Row="0" Grid.Column="0" Classes="settings-card">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding LlamaCppEnabled}" />
                        <TextBlock Text="llama.cpp" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding LlamaCppBaseUrl}"
                                 Watermark="http://localhost:8080"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- OpenAI compatible -->
            <Border Grid.Row="0" Grid.Column="1" Classes="settings-card">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding OpenAiEnabled}" />
                        <TextBlock Text="OpenAI / Compatible API" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto"
                          RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenAiBaseUrl}"
                                 Watermark="https://api.openai.com"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenAiApiKey}"
                                 PasswordChar="*" Watermark="sk-..."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAG Embeddings -->
            <Border Grid.Row="1" Grid.Column="0" Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="RAG Embeddings" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="Embed model"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding EmbeddingModel}"
                                 Watermark="nomic-embed-text"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                    </Grid>
                    <TextBlock Text="Embedding model used for RAG. Managed separately via Services panel."
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Text to speech -->
            <Border Grid.Row="1" Grid.Column="1" Classes="settings-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding TtsEnabled}" />
                            <TextBlock Text="XTTS v2" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TtsStatus}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding StartTtsCommand}"
                                IsVisible="{Binding !IsTtsRunning}"
                                Content="Start" FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Grid.Column="1" Command="{Binding StopTtsCommand}"
                                IsVisible="{Binding IsTtsRunning}"
                                Content="Stop" FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Grid.Column="2" Classes="icon-btn"
                                Command="{Binding RefreshTtsVoicesCommand}"
                                ToolTip.Tip="Refresh XTTS voices">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4a8 8 0 0 0-8 8h2.5l-3.5 3.5L-.5 12H2a10 10 0 0 1 17.07-7.07l-1.42 1.42zM6.35 17.65C7.8 19.1 9.79 20 12 20a8 8 0 0 0 8-8h-2.5l3.5-3.5 3.5 3.5H22a10 10 0 0 1-17.07 7.07l1.42-1.42z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TtsServiceUrl}"
                                 Watermark="http://127.0.0.1:8020"
                                 ToolTip.Tip="Local XTTS API endpoint Aether will call for voice playback."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speaker"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding TtsVoices}"
                                  SelectedItem="{Binding TtsSpeaker}"
                                  FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Device"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding TtsDevices}"
                                  SelectedItem="{Binding TtsDevice}"
                                  FontSize="13" />
                        <CheckBox Grid.Row="2" Grid.Column="2"
                                  IsChecked="{Binding TtsPreload}"
                                  Content="Preload"
                                  FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Version"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TtsModelVersion}"
                                 ToolTip.Tip="XTTS model version used when the API script loads by model name."
                                 Watermark="2.0.3" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Python"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TtsPythonPath, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="/path/to/venv/bin/python"
                                 ToolTip.Tip="Python executable in the XTTS venv. Local AI Setup can create one after approval."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="4" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsPythonCommand}"
                                ToolTip.Tip="Choose XTTS venv Python">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Script"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TtsScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="/path/to/xtts_api_server.py" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="5" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsScriptCommand}"
                                ToolTip.Tip="Choose XTTS script">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Model dir"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TtsModelDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="XTTS v2 model folder"
                                 ToolTip.Tip="Folder containing XTTS v2 config and model files."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="6" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsModelDirectoryCommand}"
                                ToolTip.Tip="Choose XTTS model folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Output"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TtsOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Default Aether XTTS folder" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="7" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsOutputCommand}"
                                ToolTip.Tip="Choose XTTS output folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Voices"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding TtsVoiceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Default Aether voice folder" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="8" Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseTtsVoiceDirectoryCommand}"
                                ToolTip.Tip="Choose XTTS voice sample folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Preview"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TtsPreviewText}"
                                 Watermark="Preview sentence" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="9" Grid.Column="2"
                                Command="{Binding PreviewTtsVoiceCommand}"
                                Content="Play" FontSize="12" Padding="10,5" CornerRadius="6" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Clone"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TtsCloneDisplayName}"
                                 Watermark="Imported voice name" FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Row="10" Grid.Column="2"
                                Command="{Binding ImportTtsVoiceSampleCommand}"
                                Content="Import" FontSize="12" Padding="10,5" CornerRadius="6" />
                    </Grid>
                    <TextBlock Text="Audio is held in memory and piped to the system player; Aether does not keep generated WAV files."
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Defaults -->
            <Border Grid.Row="2" Grid.Column="0" Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Data Storage" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Data folder"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding DataRootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Default OS app data folder"
                                 ToolTip.Tip="Optional data root for conversations, RAG, tasks and local app state."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseDataRootCommand}"
                                ToolTip.Tip="Choose data folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding DataMigrationPreview}"
                               FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="AI assets"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding LocalAiAssetsRoot, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Folder containing local models, XTTS, venvs, encoders"
                                 ToolTip.Tip="Point Aether at your local AI folder. The scan is read-only until you approve setup actions."
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseLocalAiAssetsRootCommand}"
                                ToolTip.Tip="Choose local AI assets folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ApplyLocalAiAssetsCommand}"
                                Content="Apply Detected Paths"
                                FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Command="{Binding ScanLocalAiSetupCommand}"
                                Content="Scan Setup"
                                IsEnabled="{Binding !LocalAiSetupBusy}"
                                ToolTip.Tip="Scan the selected AI folder and list missing setup pieces."
                                FontSize="12" Padding="12,5" CornerRadius="6" />
                        <TextBlock Text="{Binding LocalAiAssetsStatus}"
                                   VerticalAlignment="Center"
                                   FontSize="11" Opacity="0.45"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Expander Header="Local AI Setup"
                              IsExpanded="True"
                              ToolTip.Tip="Approval-gated helper for venv, XTTS API script and support folders.">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="{Binding LocalAiSetupSummary}"
                                       FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding LocalAiReadinessItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:LocalAiReadinessItem">
                                        <Grid ColumnDefinitions="110,78,*" ColumnSpacing="8" Margin="0,0,0,5">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="12" Opacity="0.78" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Opacity="0.55"
                                                       TextWrapping="Wrap" ToolTip.Tip="{Binding Hint}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding LocalAiSetupActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:LocalAiSetupAction">
                                        <Border CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" Opacity="0.58"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Approve"
                                                            IsEnabled="{Binding CanRun}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.RunLocalAiSetupActionCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Run this setup action after reviewing target, risk and command."
                                                            FontSize="12" Padding="10,5" CornerRadius="6" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding RiskLabel}" FontSize="11" Opacity="0.75" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedResult}" FontSize="11" Opacity="0.55"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                                <TextBlock Text="{Binding CommandPreviewText}"
                                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                                           FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding LocalAiSetupLog}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="74" MaxHeight="160"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Mono, monospace"
                                         FontSize="11" />
                                <Button Grid.Column="1" Command="{Binding CopyLocalAiSetupCommandsCommand}"
                                        Content="Copy"
                                        VerticalAlignment="Top"
                                        ToolTip.Tip="Copy the current setup command previews."
                                        FontSize="12" Padding="10,5" CornerRadius="6" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Backup to"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding BackupDirectory}"
                                 Watermark="Backup folder"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseBackupDirectoryCommand}"
                                ToolTip.Tip="Choose backup folder">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Restore"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding RestoreBackupPath}"
                                 Watermark="aether-backup.zip"
                                 FontSize="13" CornerRadius="6" Padding="10,6" />
                        <Button Grid.Column="2"
                                Classes="icon-btn"
                                Command="{Binding BrowseRestoreBackupCommand}"
                                ToolTip.Tip="Choose backup zip">
                            <PathIcon Data="M16 6v8h3l-4 4-4-4h3V6h2zM5 20h14v-2H5v2z"
                                      Width="15" Height="15" />
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding BackupDataCommand}" Content="Backup Now"
                                FontSize="12" Padding="12,5" CornerRadius="6" />
                        <Button Command="{Binding RestoreDataCommand}" Content="Restore"
                                FontSize="12" Padding="12,5" CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Defaults" FontSize="14" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding Temperature}"
                                       Minimum="0" Maximum="2" Increment="0.1"
                                       FormatString="F1" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max tokens"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding MaxTokens}"
                                       Minimum="256" Maximum="128000" Increment="256"
                                       FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Font size"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding FontSize}"
                                       Minimum="10" Maximum="24" Increment="1"
                                       FontSize="13" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Theme"
                                   VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  FontSize="13" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Default system prompt" Opacity="0.6" FontSize="13" />
                        <TextBox Text="{Binding DefaultSystemPrompt}"
                                 Watermark="You are a helpful assistant..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="72" FontSize="13"
                                 CornerRadius="6" Padding="10,8" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding CtrlEnterToSend}"
                              Content="Ctrl+Enter to send (Enter inserts newline)"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding ShowQuickChat}"
                              Content="Show compact quick-chat surface"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding EnableTrayIcon}"
                              Content="Show tray icon"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding MinimizeToTray}"
                              Content="Minimize to tray"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding EnableLocalHotkeys}"
                              Content="Enable local hotkeys"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding EnableGlobalHotkeys}"
                              Content="Enable system-wide hotkeys"
                              FontSize="13" />
                    <CheckBox IsChecked="{Binding StartMinimized}"
                              Content="Start minimized"
                              FontSize="13" />
                    <TextBlock Text="Local hotkeys: Ctrl+Space toggles quick chat, Ctrl+N starts a chat, Ctrl+Shift+S opens Services, Esc closes quick chat."
                               FontSize="11"
                               Opacity="0.45"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GlobalHotkeyStatus}"
                               FontSize="11"
                               Opacity="0.45"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="settings-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Trust &amp; Safety" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TrustSummary}"
                                       FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TrustLastScanned}"
                                       FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RescanTrustCommand}"
                                IsEnabled="{Binding !TrustScanBusy}"
                                Content="Rescan Trust"
                                ToolTip.Tip="Review configured executables, scripts, model paths, endpoints and network-facing extra args."
                                Padding="12,6"
                                CornerRadius="6" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TrustItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:TrustItem">
                                <Border CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,8"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="1.1*,1.2*,0.8*,0.8*,1.4*"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="10"
                                          RowSpacing="5">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.5" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Target}"
                                                   FontSize="11"
                                                   Opacity="0.68"
                                                   TextWrapping="Wrap"
                                                   ToolTip.Tip="{Binding ResolvedTarget}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding StatusLabel}"
                                                   FontSize="12"
                                                   Opacity="0.78" />
                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                   Text="{Binding RiskLabel}"
                                                   FontSize="12"
                                                   Opacity="0.78" />
                                        <TextBlock Grid.Row="0" Grid.Column="4"
                                                   Text="{Binding ScopeLabel}"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding ShaShort}"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   FontSize="11"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                   Text="{Binding Recommendation}"
                                                   FontSize="11"
                                                   Opacity="0.62"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Saved" IsVisible="{Binding IsSaved}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="{Binding SettingsError}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
