<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.SettingsLlmSectionView"
             x:DataType="vm:LlmDefaultsSettingsViewModel">
    <StackPanel Spacing="16">
        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding LlamaCppEnabled}" />
                    <TextBlock Text="llama.cpp" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Column="1" Text="{Binding LlamaCppBaseUrl}" Watermark="http://localhost:39201"
                             FontSize="13" CornerRadius="6" Padding="10,6" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding OpenAiEnabled}" />
                    <TextBlock Text="OpenAI / Compatible API" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenAiBaseUrl}" Watermark="https://api.openai.com"
                             FontSize="13" CornerRadius="6" Padding="10,6" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenAiApiKey}" PasswordChar="*" Watermark="sk-..."
                             FontSize="13" CornerRadius="6" Padding="10,6" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <TextBlock Text="Defaults" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2"
                                   Increment="0.1" FormatString="F1" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max tokens" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxTokens}" Minimum="256" Maximum="128000"
                                   Increment="256" FontSize="13" />
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Default system prompt" Opacity="0.6" FontSize="13" />
                    <TextBox Text="{Binding DefaultSystemPrompt}" Watermark="You are a helpful assistant..."
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" FontSize="13"
                             CornerRadius="6" Padding="10,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
