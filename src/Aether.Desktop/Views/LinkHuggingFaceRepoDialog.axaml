<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aether.Desktop.Views.LinkHuggingFaceRepoDialog"
        Title="Link to Hugging Face repo"
        Width="440"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="18">
        <StackPanel Spacing="14">
            <TextBlock Name="MessageText" TextWrapping="Wrap" />
            <TextBox Name="RepoIdBox" Watermark="org/repo, e.g. unsloth/gemma-3-12b-it-GGUF" />
            <TextBlock Text="Validated against huggingface.co before saving. Anonymous, public repos only."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.6" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel" MinWidth="90" Click="OnCancelClick" />
                <Button Content="Link" MinWidth="90" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
