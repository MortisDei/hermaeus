<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             xmlns:m="using:Aether.Core.Models"
             xmlns:views="using:Aether.Desktop.Views"
             x:Class="Aether.Desktop.Views.DoctorView"
             x:DataType="vm:DoctorViewModel">

    <UserControl.Resources>
        <views:DoctorStatusColorConverter x:Key="DoctorStatusColor" />
    </UserControl.Resources>

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Aether Doctor" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Scan the local environment and services for issues." FontSize="13" Opacity="0.5" />
            </StackPanel>

            <Border Classes="settings-card" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastScanned}" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding !IsScanning}"
                                    Content="Run Doctor"
                                    Padding="12,6"
                                    CornerRadius="6" />
                            <Button Command="{Binding CopyAllDiagnosticsCommand}"
                                    Content="Copy Diagnostics"
                                    Padding="12,6"
                                    CornerRadius="6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:DoctorCheck">
                        <Border CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource DoctorStatusColor}}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding FixLabel}"
                                                IsEnabled="{Binding CanFix}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RunFixCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="10,5" CornerRadius="6" />
                                        <Button Content="Copy"
                                                Command="{Binding $parent[ItemsControl].DataContext.CopyDiagnosticsCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="10,5" CornerRadius="6" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
