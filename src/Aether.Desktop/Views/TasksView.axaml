<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Spacing="18">
            <TextBlock Text="Tasks" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Local reminders and app-running automations. Nothing runs while Aether is closed."
                       FontSize="13"
                       Opacity="0.5"
                       TextWrapping="Wrap" />

            <Border Classes="settings-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="New Task" FontSize="15" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="1.2*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding NewTaskTitle}"
                                 Watermark="Title"
                                 CornerRadius="6"
                                 Padding="10,6" />
                        <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                            SelectedDate="{Binding NewTaskDueAt}"
                                            Watermark="Due date" />
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 Text="{Binding NewTaskNotes}"
                                 Watermark="Notes"
                                 CornerRadius="6"
                                 Padding="10,6" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Command="{Binding AddTaskCommand}"
                                Content="Add"
                                Padding="16,7"
                                CornerRadius="6" />
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LocalTaskItemViewModel">
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="1.5*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Text="{Binding Title}"
                                         CornerRadius="6"
                                         Padding="10,6" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          SelectedItem="{Binding Status}"
                                          ItemsSource="{Binding $parent[UserControl].DataContext.TaskStatuses}" />
                                <CalendarDatePicker Grid.Row="0" Grid.Column="2"
                                                    SelectedDate="{Binding DueAt}" />
                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save"
                                            Command="{Binding $parent[ItemsControl].DataContext.SaveTaskCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Command="{Binding $parent[ItemsControl].DataContext.DeleteTaskCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                         Text="{Binding Notes}"
                                         Watermark="Notes"
                                         CornerRadius="6"
                                         Padding="10,6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="settings-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="New Automation" FontSize="15" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="1.1*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding NewAutomationTitle}"
                                 Watermark="Title"
                                 CornerRadius="6"
                                 Padding="10,6" />
                        <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                            SelectedDate="{Binding NewAutomationRunAt}"
                                            Watermark="Run date" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Command="{Binding AddAutomationCommand}"
                                Content="Schedule"
                                Padding="16,7"
                                CornerRadius="6" />
                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="{Binding NewAutomationPrompt}"
                                 Watermark="Prompt to run"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 CornerRadius="6"
                                 Padding="10,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Automations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AutomationItemViewModel">
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="1.4*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Text="{Binding Title}"
                                         CornerRadius="6"
                                         Padding="10,6" />
                                <CalendarDatePicker Grid.Row="0" Grid.Column="1"
                                                    SelectedDate="{Binding NextRunAt}" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <CheckBox Content="Enabled"
                                              IsChecked="{Binding Enabled}"
                                              VerticalAlignment="Center" />
                                    <Button Content="Save"
                                            Command="{Binding $parent[ItemsControl].DataContext.SaveAutomationCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Command="{Binding $parent[ItemsControl].DataContext.DeleteAutomationCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                         Text="{Binding Prompt}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="72"
                                         CornerRadius="6"
                                         Padding="10,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding LastRun}"
                                           FontSize="11"
                                           Opacity="0.45"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
