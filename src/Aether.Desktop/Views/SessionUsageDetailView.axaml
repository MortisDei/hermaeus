<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.ViewModels"
             x:Class="Aether.Desktop.Views.SessionUsageDetailView"
             x:DataType="vm:SessionUsageDetailViewModel">

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Spacing="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Session Usage - Details" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConversationTitle}" Opacity="0.6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox SelectedItem="{Binding Sort}" Width="180">
                        <ComboBoxItem Content="Created (desc)" Tag="CreatedDesc" />
                        <ComboBoxItem Content="Created (asc)" Tag="CreatedAsc" />
                        <ComboBoxItem Content="Importance (desc)" Tag="ImportanceDesc" />
                        <ComboBoxItem Content="Importance (asc)" Tag="ImportanceAsc" />
                    </ComboBox>
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="8,6" />
                </StackPanel>
            </StackPanel>

            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SessionUsageDetailItemViewModel">
                                <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Category}" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CreatedAt}" FontSize="11" Opacity="0.6" />
                                            <TextBlock Text="Importance: {Binding Importance}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
