<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aether.ViewModels"
             x:Class="Aether.Desktop.Controls.DiffView">
  <ScrollViewer>
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="2">
            <TextBlock Text="{Binding OldLineNumber}" HorizontalAlignment="Right" Width="40"/>
            <TextBlock Grid.Column="1" Text="{Binding OldText}" Margin="6,0"/>
            <TextBlock Grid.Column="2" Text="{Binding NewLineNumber}" HorizontalAlignment="Right" Width="40"/>
            <TextBlock Grid.Column="3" Text="{Binding NewText}" Margin="6,0"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
