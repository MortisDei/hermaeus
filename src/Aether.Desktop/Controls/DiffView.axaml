<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aether.ViewModels"
             xmlns:conv="clr-namespace:Aether.Desktop.Controls"
             x:Class="Aether.Desktop.Controls.DiffView">
  <UserControl.Resources>
    <conv:DiffTypeToBrushConverter x:Key="DiffBrush" />
  </UserControl.Resources>
  <ScrollViewer>
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="40,*,40,*" Margin="2" Background="{Binding Type, Converter={StaticResource DiffBrush}}">
            <TextBlock Text="{Binding OldLineNumber}" HorizontalAlignment="Right" Width="40" Margin="4,0"/>
            <TextBlock Grid.Column="1" Text="{Binding OldText}" Margin="6,0" />
            <TextBlock Grid.Column="2" Text="{Binding NewLineNumber}" HorizontalAlignment="Right" Width="40" Margin="4,0"/>
            <TextBlock Grid.Column="3" Text="{Binding NewText}" Margin="6,0" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
