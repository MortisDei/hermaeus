<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aether.Agent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <!-- Pins the patched native SQLite; Microsoft.Data.Sqlite 9.0.x still pulls the vulnerable 2.1.10 (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aether.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in Agent Scenario Suite library; copied to every consumer's output
         (Desktop, Tests) so IAgentScenarioStore can find it at
         {AppContext.BaseDirectory}/agent-scenarios without a runtime download. -->
    <None Include="Scenarios\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="agent-scenarios\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Scenario workspace fixtures include .cs files that are fixture DATA
         (sample code a scenario's agent run edits), not source for this
         assembly; without this they compile into Aether.Agent.dll's global
         namespace and can shadow real types for consumers (e.g. a stray
         global "App" class collided with Aether.Desktop.App in Aether.Tests). -->
    <Compile Remove="Scenarios\**\*.cs" />
  </ItemGroup>
</Project>
