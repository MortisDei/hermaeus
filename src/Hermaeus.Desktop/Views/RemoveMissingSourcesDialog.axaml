<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.RemoveMissingSourcesDialog"
        Title="Remove Missing Sources"
        Width="520"
        Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Paths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="avares://Hermaeus.Desktop/Assets/Fonts/JetBrainsMono#JetBrains Mono,Consolas,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="3"
                       Text="This deletes the chunks for these sources from the dataset. This action cannot be undone."
                       TextWrapping="Wrap"
                       Foreground="Red"
                       Opacity="0.8" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" MinWidth="90" Click="OnCancelClick" />
                <Button Content="Remove" MinWidth="90" Foreground="Red" Click="OnRemoveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
