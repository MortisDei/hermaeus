<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.EmptyDirectoryCleanupDialog"
        Title="Remove empty folders"
        Width="440"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="18">
        <StackPanel Spacing="14">
            <TextBlock Name="MessageText" TextWrapping="Wrap" />
            <TextBlock Text="This only removes folders that are still empty; no files are ever deleted."
                       TextWrapping="Wrap"
                       Opacity="0.7" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Leave them" MinWidth="90" Click="OnCancelClick" />
                <Button Content="Remove" MinWidth="90" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
