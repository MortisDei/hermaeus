<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:views="using:Hermaeus.Desktop.Views"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             xmlns:services="using:Hermaeus.Services"
             x:Class="Hermaeus.Desktop.Views.SetupWizardView"
             x:DataType="vm:SetupWizardViewModel">

    <Border Padding="24"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel MaxWidth="760" Spacing="16">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:MossIcon Width="28" Height="28"
                                        ToolTip.Tip="Moss keeps an eye on setup so nothing gets left half-configured." />
                    <TextBlock Text="First-Run Setup" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Set up storage, runtimes, models, and voice." FontSize="13" Opacity="0.5" />
            </StackPanel>

            <Border CornerRadius="8" Padding="12"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <controls:MossIcon Width="22" Height="22"
                                       ToolTip.Tip="Moss gives brief factual setup guidance." />
                    <TextBlock Grid.Column="1" Text="{Binding GuidanceText}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Classes="settings-card" Padding="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CurrentStepTitle}" FontSize="14" FontWeight="SemiBold" />

                    <StackPanel IsVisible="{Binding IsStep0}" Spacing="10">
                        <TextBlock Text="Choose your data root and AI assets folder." FontSize="12" Opacity="0.6" />
                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Data root" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding DataRootDirectory}" Watermark="Default app data folder" />
                            <Button Grid.Column="2" Command="{Binding BrowseDataRootCommand}" Content="Browse" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="AI assets" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding LocalAiAssetsRoot}" Watermark="Local AI assets folder" />
                            <Button Grid.Column="2" Command="{Binding BrowseLocalAiAssetsRootCommand}" Content="Browse" />
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStep1}" Spacing="10">
                        <TextBlock Text="Pick the chat backend you want to use." FontSize="12" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding RuntimeOptions}"
                                  SelectedItem="{Binding SelectedRuntime}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:RuntimeProfileViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Classes="settings-card" Padding="12" IsVisible="{Binding SelectedRuntimeUsesManagedLlama}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ManagedLlamaReadinessSummary}" FontSize="12" TextWrapping="Wrap" />
                                <Button Content="Install managed llama.cpp"
                                        Command="{Binding InstallManagedLlamaCommand}"
                                        IsVisible="{Binding CanInstallManagedLlama}"
                                        IsEnabled="{Binding !IsInstallingManagedLlama}"
                                        ToolTip.Tip="Downloads the newest compatible b-numbered llama.cpp build and links it to Services." />
                                <TextBlock Text="{Binding ManagedLlamaInstallProgress}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ManagedLlamaInstallError}" FontSize="11" Foreground="#EF5350" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStep2}" Spacing="10">
                        <TextBlock Text="Choose a model, or let Hermaeus download one sized for your hardware." FontSize="12" Opacity="0.6" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton GroupName="ModelSource" Content="I have a model"
                                         IsChecked="{Binding !UseStarterModelDownload}"
                                         ToolTip.Tip="Point Hermaeus at a GGUF file already on this machine." />
                            <RadioButton GroupName="ModelSource" Content="Download a starter model (recommended)"
                                         IsChecked="{Binding UseStarterModelDownload}"
                                         ToolTip.Tip="Download a small, hardware-appropriate instruct model automatically, with its hash verified before use." />
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8" IsVisible="{Binding !UseStarterModelDownload}">
                            <TextBlock Grid.Column="0" Text="Model path" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ModelFolder}" Watermark="Path to a GGUF model"
                                     ToolTip.Tip="Full path to a .gguf chat model file for llama.cpp to load." />
                            <Button Grid.Column="2" Command="{Binding BrowseModelFolderCommand}" Content="Browse"
                                    ToolTip.Tip="Pick a .gguf file from disk." />
                        </Grid>

                        <StackPanel IsVisible="{Binding UseStarterModelDownload}" Spacing="8">
                            <!-- The wizard suggests a size from the machine's VRAM, but the
                                 choice is the user's: model family and fit still matter. -->
                            <ComboBox ItemsSource="{Binding StarterModels}"
                                      SelectedItem="{Binding SelectedStarterModel}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="13"
                                      ToolTip.Tip="Every option downloads once from Hugging Face and then runs fully offline.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="services:StarterModelEntry">
                                        <StackPanel Spacing="1" Margin="0,2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                            <TextBlock Text="{Binding LicenseDisplay}"
                                                       IsVisible="{Binding HasLicense}"
                                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border CornerRadius="4" Padding="6,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding RecommendedStarterModelFitLabel, Converter={x:Static views:NotEmptyConverter.Instance}}"
                                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                                        ToolTip.Tip="{Binding RecommendedStarterModelFitReason}">
                                    <TextBlock Text="{Binding RecommendedStarterModelFitLabel}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="Recommended for your GPU"
                                           IsVisible="{Binding SelectedStarterModelIsRecommended}"
                                           FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedStarterModel.LicenseDisplay}"
                                       IsVisible="{Binding SelectedStarterModel.HasLicense}"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock Text="Downloads once, then runs fully offline. The model's licence is the publisher's, not Hermaeus's; read it before you rely on the model for anything."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <Button Content="Download starter model"
                                    Command="{Binding DownloadStarterModelCommand}"
                                    IsEnabled="{Binding !IsDownloadingStarterModel}"
                                    ToolTip.Tip="Downloads the model from Hugging Face and verifies its SHA256 hash before using it." />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding StarterModelDownloadPercent}"
                                         IsVisible="{Binding IsDownloadingStarterModel}" Height="6" />
                            <TextBlock Text="{Binding StarterModelDownloadStatus}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StarterModelDownloadError}" FontSize="11" Foreground="#EF5350" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStep3}" Spacing="10">
                        <TextBlock Text="Select a voice provider." FontSize="12" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding VoiceOptions}"
                                  SelectedItem="{Binding SelectedVoiceProvider}"
                                  ToolTip.Tip="Which text-to-speech engine Hermaeus uses for spoken replies."
                         />
                        <Border Classes="settings-card" Padding="12" IsVisible="{Binding HasVoiceOnboardingSummary}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding VoiceOnboardingSummary}" FontSize="12" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding VoiceOnboardingSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding VoiceOnboardingRiskNotes}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />

                                <StackPanel IsVisible="{Binding CanInstallSelectedVoiceProvider}" Spacing="6">
                                    <Button Content="Install now"
                                            Command="{Binding InstallVoiceCommand}"
                                            IsEnabled="{Binding !IsInstallingVoice}"
                                            ToolTip.Tip="Downloads and verifies the native Kokoro model and voice files now, so speech works immediately." />
                                    <TextBlock Text="{Binding VoiceInstallProgress}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceInstallError}" FontSize="11" Foreground="#EF5350" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStep4}" Spacing="10">
                        <TextBlock Text="Run Doctor to confirm everything is ready." FontSize="12" Opacity="0.6" />
                        <Button Command="{Binding RunDoctorCommand}"
                                IsEnabled="{Binding !IsDoctorRunning}"
                                Content="Run Doctor"
                                ToolTip.Tip="Scans your setup for missing models, misconfigured services, and other issues." />
                        <TextBlock Text="{Binding DoctorSummary}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStep5}" Spacing="8">
                        <TextBlock Text="Finish setup and start using Hermaeus." FontSize="12" Opacity="0.6" />
                        <TextBlock Text="{Binding VoiceReadinessSummary}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Command="{Binding BackCommand}" Content="Back" />
                        <Button Command="{Binding SkipCommand}" Content="Skip" />
                        <Button Command="{Binding NextCommand}"
                            Content="Next"
                            IsVisible="{Binding IsNotLastStep}" />
                        <Button Command="{Binding FinishCommand}"
                            Content="Finish"
                            IsVisible="{Binding IsLastStep}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
