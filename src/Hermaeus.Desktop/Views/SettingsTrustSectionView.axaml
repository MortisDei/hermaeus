<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hermaeus.Core.Models"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsTrustSectionView"
             x:DataType="vm:TrustSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Trust &amp; Safety" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TrustSummary}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrustLastScanned}" FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RescanTrustCommand}" IsEnabled="{Binding !TrustScanBusy}"
                        Content="Rescan Trust" Padding="12,6" CornerRadius="6" />
            </Grid>
            <ItemsControl ItemsSource="{Binding TrustItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:TrustItem">
                        <Border CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="1.1*,1.2*,0.8*,0.8*,1.4*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.5" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Target}" FontSize="11" Opacity="0.68"
                                           TextWrapping="Wrap" ToolTip.Tip="{Binding ResolvedTarget}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StatusLabel}" FontSize="12" Opacity="0.78" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RiskLabel}" FontSize="12" Opacity="0.78" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding ScopeLabel}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ShaShort}" FontFamily="{DynamicResource AppMonoFont}"
                                           FontSize="11" Opacity="0.55" ToolTip.Tip="{Binding Sha256}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Recommendation}"
                                           FontSize="11" Opacity="0.62" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SettingsError}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
