<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsLlmSectionView"
             x:DataType="vm:LlmDefaultsSettingsViewModel">
    <StackPanel Spacing="16">
        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding LlamaCppEnabled}" ToolTip.Tip="Whether this local llama.cpp server appears as a chat provider." />
                    <TextBlock Text="llama.cpp" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Column="1" Text="{Binding LlamaCppBaseUrl}" PlaceholderText="http://localhost:39201"
                             FontSize="13" CornerRadius="6" Padding="10,6"
                             ToolTip.Tip="Address of the local llama.cpp server. Change only if it runs on a non-default port." />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding OpenAiEnabled}" ToolTip.Tip="Whether this remote provider appears as a chat option. Sends prompts off this machine." />
                    <TextBlock Text="OpenAI / Compatible API" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenAiBaseUrl}" PlaceholderText="https://api.openai.com"
                             FontSize="13" CornerRadius="6" Padding="10,6"
                             ToolTip.Tip="Any OpenAI-compatible endpoint works here, not just OpenAI itself." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenAiApiKey}" PasswordChar="*" PlaceholderText="sk-..."
                             FontSize="13" CornerRadius="6" Padding="10,6"
                             ToolTip.Tip="Stored in the OS secret store, not in plain text in settings.json." />
                </Grid>
                <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding OpenAiSupportsStructuredOutputs}"
                              Content="This endpoint enforces response_format"
                              ToolTip.Tip="Tick only if your server supports OpenAI structured outputs. Hermaeus asks it to enforce a response shape instead of refusing." />
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="Where Hermaeus needs a reply in a fixed shape, it asks the server to enforce it rather than hoping. api.openai.com always can. Other OpenAI-compatible servers vary and cannot say so, so Hermaeus refuses instead of sending a field the server might ignore. Tick this for LM Studio, vLLM and others that do support it. If the server does not, it returns an error and you will see it." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="settings-card">
            <StackPanel Spacing="12">
                <TextBlock Text="Defaults" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2"
                                   Increment="0.1" FormatString="F1" FontSize="13"
                                   ToolTip.Tip="Randomness of replies. 0 is deterministic and repetitive; higher values are more varied and less predictable." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max tokens" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxTokens}" Minimum="256" Maximum="128000"
                                   Increment="256" FontSize="13"
                                   ToolTip.Tip="Upper limit on tokens generated in one reply." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Top P" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TopP}" Minimum="0" Maximum="1"
                                   Increment="0.05" FormatString="F2" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Nucleus sampling: only considers the smallest set of next-word candidates whose combined probability reaches this value. Lower is more focused." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Top K" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TopK}" Minimum="0" Maximum="500"
                                   Increment="1" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Only considers this many most-likely next words at each step. Lower is more focused." />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Min P" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding MinP}" Minimum="0" Maximum="1"
                                   Increment="0.01" FormatString="F2" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Discards next-word candidates less likely than this fraction of the top candidate's probability." />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Repeat penalty" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding RepeatPenalty}" Minimum="0.5" Maximum="2"
                                   Increment="0.05" FormatString="F2" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Discourages repeating recent tokens. 1.0 is no penalty; higher values push harder against repetition." />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Frequency penalty" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding FrequencyPenalty}" Minimum="-2" Maximum="2"
                                   Increment="0.1" FormatString="F1" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Reduces the chance of a word reappearing in proportion to how often it has already appeared. 0 is off." />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Presence penalty" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                    <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding PresencePenalty}" Minimum="-2" Maximum="2"
                                   Increment="0.1" FormatString="F1" FontSize="13" PlaceholderText="Provider default"
                                   ToolTip.Tip="Reduces the chance of reusing any word that has appeared at all so far, encouraging new topics. 0 is off." />
                </Grid>
                <TextBlock Text="Top K/Min P/repeat penalty are llama.cpp and Ollama only; OpenAI-compatible endpoints only receive Top P and the two penalties. Leave a field blank to use the provider's own default."
                           Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Default system prompt" Opacity="0.6" FontSize="13" />
                    <TextBox Text="{Binding DefaultSystemPrompt}" PlaceholderText="You are a helpful assistant..."
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" FontSize="13"
                             CornerRadius="6" Padding="10,8"
                             ToolTip.Tip="Instructions sent with every new conversation before the user's first message." />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
