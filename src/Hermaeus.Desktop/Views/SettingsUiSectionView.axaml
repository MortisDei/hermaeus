<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsUiSectionView"
             x:DataType="vm:UiSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <TextBlock Text="Interface" FontSize="14" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Font size" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding FontSize}" Minimum="10" Maximum="24" Increment="1" FontSize="13"
                               ToolTip.Tip="Chat message text size in points. Default 14." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" FontSize="13"
                          ToolTip.Tip="Light, dark, or follow the OS theme." />
            </Grid>
            <TextBlock Text="Typography" FontSize="14" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Heading font" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HeadingFontFamily}" FontSize="13" Watermark="System default"
                         ToolTip.Tip="Font family for page titles and headings. Leave blank to use the OS default UI font. Enter the name of a font installed on this system." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Body font" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BodyFontFamily}" FontSize="13" Watermark="System default"
                         ToolTip.Tip="Font family for chat and general UI text. Leave blank to use the OS default UI font." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Code font" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MonoFontFamily}" FontSize="13" Watermark="System default"
                         ToolTip.Tip="Font family for code blocks and other technical text. Leave blank to use the OS default monospace font, e.g. Consolas." />
            </Grid>
            <CheckBox IsChecked="{Binding ShowNavLabels}" Content="Show text labels next to toolbar icons" FontSize="13"
                      ToolTip.Tip="Adds a text caption under each sidebar icon. Off by default." />
            <CheckBox IsChecked="{Binding CtrlEnterToSend}" Content="Ctrl+Enter to send (Enter inserts newline)" FontSize="13"
                      ToolTip.Tip="When on, plain Enter adds a newline in the composer and Ctrl+Enter sends." />
            <CheckBox IsChecked="{Binding ShowQuickChat}" Content="Show compact quick-chat surface" FontSize="13"
                      ToolTip.Tip="Adds a small always-available chat box outside the main window." />
            <CheckBox IsChecked="{Binding EnableTrayIcon}" Content="Show tray icon" FontSize="13"
                      ToolTip.Tip="Keeps an Hermaeus icon in the system tray while the app is running." />
            <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimize to tray" FontSize="13"
                      ToolTip.Tip="Minimizing the window hides it to the tray instead of the taskbar. Requires the tray icon to be enabled." />
            <CheckBox IsChecked="{Binding CloseToTray}" Content="Close to tray" FontSize="13"
                      ToolTip.Tip="Closing the window hides it to the tray instead of exiting. Turn this off if you want the close button to actually quit Hermaeus. Requires the tray icon to be enabled." />
            <CheckBox IsChecked="{Binding EnableLocalHotkeys}" Content="Enable local hotkeys" FontSize="13"
                      ToolTip.Tip="Keyboard shortcuts that work while the Hermaeus window is focused." />
            <CheckBox IsChecked="{Binding EnableGlobalHotkeys}" Content="Enable system-wide hotkeys" FontSize="13"
                      ToolTip.Tip="Keyboard shortcuts that work even when Hermaeus is in the background. Takes effect immediately." />
            <CheckBox IsChecked="{Binding StartMinimized}" Content="Start minimized" FontSize="13"
                      ToolTip.Tip="Launch Hermaeus directly to the tray instead of showing the window." />
            <TextBlock Text="{Binding GlobalHotkeyStatus}" FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
