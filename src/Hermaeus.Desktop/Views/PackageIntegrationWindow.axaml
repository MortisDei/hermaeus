<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.PackageIntegrationWindow"
        Title="Hermaeus desktop integration"
        Icon="/Assets/hermaeus-app.png"
        Width="520"
        Height="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <TextBlock x:Name="HeadingText"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       TextWrapping="Wrap"
                       Classes="hint" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="90"
                        Click="OnCancelClick" />
                <Button x:Name="ActionButton"
                        MinWidth="110"
                        Click="OnActionClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
