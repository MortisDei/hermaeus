<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsRagSectionView"
             x:DataType="vm:RagSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="RAG Retrieval" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Result ranking and chat context budget. The embeddings server itself (address and model) is configured on its Services card."
                           FontSize="11" Opacity="0.55" />
            </StackPanel>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Reranker" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="13" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RerankerModelPathOptions}"
                          SelectedItem="{Binding RagRerankerModelPath}" FontSize="13" CornerRadius="6"
                          ToolTip.Tip="Optional model that re-scores search results for better ordering. Leave blank to skip reranking." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chat knowledge context budget (tokens)" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="13" TextWrapping="Wrap" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ChatInjectionTokenBudget}"
                               Minimum="200" Maximum="16000" Increment="100" FontSize="13"
                               HorizontalAlignment="Left" Width="160"
                               ToolTip.Tip="Maximum tokens of retrieved context injected into chat when a conversation has a Knowledge dataset attached." />
            </Grid>
            <TextBlock Text="The optional reranker improves search result ordering; the token budget bounds how much retrieved context gets injected into chat. To change the embeddings server's address or model, see Services > Embeddings."
                       FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
