<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Hermaeus.Core.Models"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsLocalAiSetupSectionView"
             x:DataType="vm:LocalAiSetupSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Local AI Setup" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LocalAiSetupSummary}" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ApplyLocalAiAssetsCommand}" Content="Apply" FontSize="12" Padding="10,5" CornerRadius="6"
                        ToolTip.Tip="Applies the detected asset paths to your settings without running any install actions." />
                <Button Grid.Column="2" Command="{Binding ScanLocalAiSetupCommand}" Content="Scan" IsEnabled="{Binding !LocalAiSetupBusy}" FontSize="12" Padding="10,5" CornerRadius="6"
                        ToolTip.Tip="Re-checks disk for installed models, runtimes, and other local AI assets." />
                <Button Grid.Column="3" Command="{Binding CopyLocalAiSetupCommandsCommand}" Content="Copy" FontSize="12" Padding="10,5" CornerRadius="6"
                        ToolTip.Tip="Copies the setup commands for every pending action to the clipboard, for running manually." />
            </Grid>
            <ItemsControl ItemsSource="{Binding LocalAiReadinessItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:LocalAiReadinessItem">
                        <Grid ColumnDefinitions="110,78,*" ColumnSpacing="8" Margin="0,0,0,5">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="12" Opacity="0.78" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding LocalAiSetupActions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:LocalAiSetupAction">
                        <Border CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Button Content="Plan"
                                                Command="{Binding $parent[ItemsControl].DataContext.PreviewLocalAiInstallPlanCommand}"
                                                CommandParameter="{Binding}"
                                                FontSize="11" Padding="10,5" CornerRadius="6"
                                                ToolTip.Tip="Shows exactly what this action will do before you approve it." />
                                        <Button Content="Approve"
                                                IsEnabled="{Binding CanRun}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RunLocalAiSetupActionCommand}"
                                                CommandParameter="{Binding}"
                                                FontSize="11" Padding="10,5" CornerRadius="6"
                                                ToolTip.Tip="Runs this setup action now." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding RiskLabel}" FontSize="11" Opacity="0.75" />
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedResult}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{Binding CommandPreviewText}" FontFamily="avares://Hermaeus.Desktop/Assets/Fonts/JetBrainsMono#JetBrains Mono,Consolas,monospace"
                                           FontSize="11" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border CornerRadius="6" Padding="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    IsVisible="{Binding LocalAiInstallPlanVisible}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LocalAiInstallPlanTitle}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LocalAiInstallPlanSummary}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LocalAiInstallPlanRisk}" FontSize="11" Opacity="0.65" />
                    <TextBlock Text="{Binding LocalAiInstallPlanRiskNotes}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBox Text="{Binding LocalAiSetupLog}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="74" MaxHeight="160" IsReadOnly="True"
                     FontFamily="avares://Hermaeus.Desktop/Assets/Fonts/JetBrainsMono#JetBrains Mono,Consolas,monospace" FontSize="11"
                     ToolTip.Tip="Read-only output from the most recent scan or setup action." />
            <TextBlock Text="{Binding SettingsError}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
