<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:views="using:Hermaeus.Desktop.Views"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             x:Class="Hermaeus.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
    <UserControl.Resources>
        <views:ActivityOutcomeColorConverter x:Key="OutcomeColor" />
    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Activity" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="What the app has been doing in the background: servers, downloads, ingest, scans, backups."
                           FontSize="13" Opacity="0.5" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding RetentionNote}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon-btn" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh activity" Margin="0,0,6,0">
                    <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08a5.99 5.99 0 0 1-5.65 4c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Width="14" Height="14" />
                </Button>
                <Button Grid.Column="2" Content="Clear activity history" Command="{Binding ClearCommand}" FontSize="11" Padding="10,5" CornerRadius="6" />
            </Grid>

            <controls:MossEmptyState IsVisible="{Binding !HasEvents}"
                                      Title="No activity yet"
                                      Hint="Background work like server starts, ingest runs and Doctor scans will show up here." />

            <ItemsControl ItemsSource="{Binding Events}" IsVisible="{Binding HasEvents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRowViewModel">
                        <Border CornerRadius="8" BorderThickness="1" Padding="12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,3,10,0" VerticalAlignment="Top"
                                         Fill="{Binding Outcome, Converter={StaticResource OutcomeColor}}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                               IsVisible="{Binding HasReason}" />
                                    <TextBlock Text="{Binding Operation}" FontSize="10" Opacity="0.4" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="11" Opacity="0.5" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
