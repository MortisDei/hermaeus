<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.OrganizeModelsPreviewDialog"
        Title="Organize models folder"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner">
    <Border Padding="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0"
                       Text="Files below will move into the LLM folder. Filenames never change; only the folder does."
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="MovesList" />
            </ScrollViewer>
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel" MinWidth="90" Click="OnCancelClick" />
                <Button Content="Move files" MinWidth="90" Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
