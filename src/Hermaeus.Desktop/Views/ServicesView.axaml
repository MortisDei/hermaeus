<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:views="using:Hermaeus.Desktop.Views"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Hermaeus.Desktop.Views.ServicesView"
             x:DataType="vm:ServicesViewModel">

    <ScrollViewer x:Name="PageScroller"
                  Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Spacing="16">

            <!-- r29 doc 01 1.1: the Voice and STT cards at the bottom of this page
                 edit shared settings that only a save writes to disk. Save here
                 runs the same flow as the Settings page's Save button. -->
            <StackPanel Spacing="4">
                <TextBlock Text="Services" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="13" Opacity="0.45" TextWrapping="Wrap"
                           Text="Manage llama-server processes. Paths and config are saved per card with Save Config. Auto-start launches on Hermaeus startup if model path is set." />
            </StackPanel>

            <Border Classes="settings-card" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Runtime Profiles" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Connect local llama.cpp, Ollama, and OpenAI-compatible runtimes. Local llama.cpp processes still use the managed server cards below."
                                       FontSize="12" Opacity="0.5" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding AddRuntimeProfileCommand}"
                                Content="Add Runtime"
                                Padding="12,6"
                                CornerRadius="6" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RuntimeProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RuntimeProfileViewModel">
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="1.2*,1.1*,1.7*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="8">
                                        <TextBox Grid.Row="0" Grid.Column="0"
                                                 Text="{Binding Name}"
                                                 Watermark="Profile name"
                                                 CornerRadius="6"
                                                 Padding="10,6" />
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[UserControl].DataContext.RuntimeKinds}"
                                                  SelectedItem="{Binding Kind}"
                                                  CornerRadius="6"
                                                  Padding="8,4" />
                                        <TextBox Grid.Row="0" Grid.Column="2"
                                                 Text="{Binding BaseUrl}"
                                                 Watermark="http://127.0.0.1:8080"
                                                 CornerRadius="6"
                                                 Padding="10,6" />
                                        <StackPanel Grid.Row="0" Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                            <CheckBox Content="Enabled"
                                                      IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center"
                                                      FontSize="12" />
                                            <Button Content="Health"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CheckRuntimeProfileCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <TextBox Grid.Row="1" Grid.Column="0"
                                                 Text="{Binding ApiKey}"
                                                 PasswordChar="*"
                                                 Watermark="API key"
                                                 CornerRadius="6"
                                                 Padding="10,6" />
                                        <CheckBox Grid.Row="1" Grid.Column="1"
                                                  Content="Start managed llama.cpp"
                                                  IsChecked="{Binding StartManagedLlamaServer}"
                                                  IsVisible="{Binding IsLlamaCpp}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="2"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding HealthMessage}"
                                                       FontSize="12"
                                                       Opacity="0.55"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Unsafe host: 0.0.0.0 exposes this runtime beyond localhost."
                                                       IsVisible="{Binding HasUnsafeHost}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Save"
                                                    Command="{Binding $parent[ItemsControl].DataContext.SaveRuntimeProfileCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete"
                                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteRuntimeProfileCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Servers}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ServerProcessViewModel">
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="12">

                                <!-- ── Header row ─────────────────────────── -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                                    <!-- Status dot -->
                                    <Border Grid.Column="0"
                                            Width="10" Height="10"
                                            CornerRadius="5"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding StatusTooltip}"
                                            Background="{Binding Status,
                                                Converter={x:Static views:ServicesView.StatusColor}}" />

                                    <StackPanel Grid.Column="1" Spacing="1"
                                                ToolTip.Tip="{Binding StatusTooltip}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11" Opacity="0.5" />
                                    </StackPanel>

                                    <!-- Start button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding StartCommand}"
                                            IsVisible="{Binding IsStopped}"
                                            Content="Start"
                                            Padding="14,6" CornerRadius="6" FontSize="13" />

                                    <!-- Starting indicator -->
                                    <StackPanel Grid.Column="2"
                                                IsVisible="{Binding IsStarting}"
                                                Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Starting…" FontSize="13" Opacity="0.6" />
                                    </StackPanel>

                                    <!-- Stop button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding StopCommand}"
                                            IsVisible="{Binding IsRunning}"
                                            Content="Stop"
                                            Padding="14,6" CornerRadius="6" FontSize="13" />

                                    <!-- Toggle log -->
                                    <Button Grid.Column="3"
                                            Classes="icon-btn"
                                            Command="{Binding ToggleLogCommand}"
                                            Margin="4,0,0,0"
                                            ToolTip.Tip="Show/hide log">
                                        <PathIcon Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                                                  Width="15" Height="15" Opacity="0.5" />
                                    </Button>
                                </Grid>

                                <!-- ── Error banner ──────────────────────── -->
                                <Border IsVisible="{Binding IsError}"
                                        CornerRadius="6" Padding="10,6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:MossIcon Width="16" Height="16"
                                                            VerticalAlignment="Top"
                                                            ToolTip.Tip="Right. Let's see what broke." />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- ── Orphan-from-previous-session banner (r9 2.3) ── -->
                                <Border IsVisible="{Binding HasOrphan}"
                                        CornerRadius="6" Padding="10,6"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OrphanBannerText}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Button Grid.Column="1"
                                                Command="{Binding StopOrphanCommand}"
                                                IsVisible="{Binding CanStopOrphan}"
                                                Content="Stop"
                                                Padding="12,4" CornerRadius="6" FontSize="12" />
                                    </Grid>
                                </Border>

                                <!-- ── Config grid ───────────────────────── -->
                                <Grid ColumnDefinitions="100,*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="8" ColumnSpacing="10">

                                    <!-- Executable -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Executable" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding ExecutablePath}"
                                                 Watermark="llama-server  or  /full/path/llama-server"
                                                 FontSize="13" CornerRadius="6" Padding="10,6"
                                                 IsEnabled="{Binding CanEdit}"
                                                 ToolTip.Tip="Full path or PATH command for llama-server. Trust scan can hash local files and warn outside the AI root." />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Classes="icon-btn"
                                            Command="{Binding BrowseExecutableCommand}"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip.Tip="Browse for executable">
                                        <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                                  Width="15" Height="15" />
                                    </Button>

                                    <!-- Model -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Model (.gguf)" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                        <ComboBox ItemsSource="{Binding DetectedModelPaths}"
                                                  SelectedItem="{Binding ModelPath}"
                                                  PlaceholderText="Select a detected model..."
                                                  HorizontalAlignment="Stretch"
                                                  FontSize="13" CornerRadius="6"
                                                  IsEnabled="{Binding CanEdit}"
                                                  ToolTip.Tip="GGUF models detected under your configured AI assets root.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding EmbedUrlLabel, StringFormat='Embed URL: {0}'}"
                                                   IsVisible="{Binding EmbeddingsMode}"
                                                   FontSize="11" Opacity="0.5"
                                                   ToolTip.Tip="Chat/RAG reach this embeddings server here. Follows Port above; not separately configurable." />
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Classes="icon-btn"
                                            VerticalAlignment="Top"
                                            Command="{Binding BrowseModelCommand}"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip.Tip="Browse for model file">
                                        <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                                  Width="15" Height="15" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelPathHint}"
                                               IsVisible="{Binding HasMissingModel}"
                                               Grid.ColumnSpan="2" Margin="0,34,0,0"
                                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

                                    <!-- r19 5.3: vision projector, optional; auto-suggested from
                                         mmproj-*.gguf files beside the selected model. -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Vision projector" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                        <ComboBox ItemsSource="{Binding DetectedMmprojPaths}"
                                                  SelectedItem="{Binding MmprojPath}"
                                                  PlaceholderText="None (text-only)"
                                                  HorizontalAlignment="Stretch"
                                                  FontSize="13" CornerRadius="6"
                                                  IsEnabled="{Binding CanEdit}"
                                                  ToolTip.Tip="mmproj-*.gguf projector file. Its path is retained independently from whether this server uses it.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Content="Use projector"
                                                  IsChecked="{Binding UseProjector}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  FontSize="12"
                                                  ToolTip.Tip="When off, the configured projector path and provenance stay saved, but --mmproj is omitted from this server launch."
                                                  />
                                        <TextBlock Text="{Binding MmprojHint}"
                                                   IsVisible="{Binding HasMissingMmproj}"
                                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                        <Button Content="Clear projector"
                                                Command="{Binding ClearMmprojCommand}"
                                                IsVisible="{Binding HasMissingMmproj}"
                                                HorizontalAlignment="Left"
                                                Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Classes="icon-btn"
                                            VerticalAlignment="Top"
                                            Command="{Binding BrowseMmprojCommand}"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip.Tip="Browse for a projector file">
                                        <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                                                  Width="15" Height="15" />
                                    </Button>
                                    <!-- Numeric params -->
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Port / Ctx / GPU" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <Grid Grid.Row="3" Grid.Column="1"
                                          ColumnDefinitions="140,140,132"
                                          ColumnSpacing="8">
                                        <NumericUpDown Value="{Binding Port}"
                                                       Minimum="1024" Maximum="65535"
                                                       Increment="1"
                                                       Width="132" HorizontalAlignment="Left"
                                                       FontSize="13"
                                                       IsEnabled="{Binding CanEdit}"
                                                       ToolTip.Tip="Port" />
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding ContextSize}"
                                                       Minimum="512" Maximum="131072"
                                                       Increment="512"
                                                       Width="132" HorizontalAlignment="Left"
                                                       FontSize="13"
                                                       IsEnabled="{Binding CanEdit}"
                                                       ToolTip.Tip="Context size (tokens)" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <ComboBox ItemsSource="{Binding GpuPlacementOptions}"
                                                      SelectedItem="{Binding GpuPlacementSelection}"
                                                      Width="76"
                                                      FontSize="12"
                                                      IsEnabled="{Binding CanEdit}"
                                                      ToolTip.Tip="GPU placement intent: CPU, runtime Auto, all layers, or an exact layer count." />
                                            <NumericUpDown Value="{Binding GpuLayers}"
                                                           Minimum="1" Maximum="999"
                                                           Increment="1"
                                                           Width="48"
                                                           IsVisible="{Binding IsExactGpuPlacement}"
                                                           IsEnabled="{Binding CanEdit}"
                                                           ToolTip.Tip="Exact GPU layer count" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Threads -->
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Threads" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <Grid Grid.Row="4" Grid.Column="1"
                                          ColumnDefinitions="140,Auto,120,Auto,*"
                                          ColumnSpacing="16">
                                        <NumericUpDown Value="{Binding Threads}"
                                                       Minimum="1" Maximum="128"
                                                       Increment="1"
                                                       HorizontalAlignment="Stretch"
                                                       FontSize="13"
                                                       IsEnabled="{Binding CanEdit}"
                                                       ToolTip.Tip="CPU thread count" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Offload:" Opacity="0.6" FontSize="13" />
                                            <TextBlock Text="{Binding EffectiveOffloadLabel}" FontSize="13" />
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="2"
                                                       Value="{Binding Slots}"
                                                       Minimum="1" Maximum="32"
                                                       Increment="1"
                                                       HorizontalAlignment="Stretch"
                                                       FontSize="13"
                                                       IsEnabled="{Binding CanEdit}"
                                                       ToolTip.Tip="Advanced: parallel request slots (--parallel N). Keep at 1 for a single-user chat app so the whole context belongs to one conversation and every send reuses the KV cache." />
                                        <CheckBox Grid.Column="3"
                                                  IsChecked="{Binding AutoStart}"
                                                  Content="Auto-start"
                                                  FontSize="13"
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Extra args -->
                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="Extra args" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding ExtraArgs}"
                                             Watermark="--flash-attn --mlock  etc."
                                             FontSize="13" CornerRadius="6" Padding="10,6"
                                             IsEnabled="{Binding CanEdit}"
                                             ToolTip.Tip="Extra llama-server arguments are passed without a shell. Network flags such as --host 0.0.0.0 produce a trust warning. Quote a value containing spaces, e.g. --mmproj &quot;C:\models\a b\proj.gguf&quot;; a backslash is only an escape before a quote or another backslash, so plain Windows paths like C:\models\proj.gguf do not need to be escaped." />

                                    <!-- r18 04-llama-server-engine-options.md 4.1: first-class
                                         engine options. Defaults (f16/auto/off) are byte-identical
                                         to pre-r18 launches; nothing here is ever forced. -->
                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Text="KV cache / engine" VerticalAlignment="Center"
                                               Opacity="0.6" FontSize="13" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6">
                                        <Grid ColumnDefinitions="Auto,110,Auto,140" ColumnSpacing="8">
                                            <TextBlock Text="KV cache:" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding KvCacheTypeOptions}"
                                                      SelectedItem="{Binding KvCacheType}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      FontSize="12"
                                                      ToolTip.Tip="Hermaeus applies this one KV cache choice to both K and V. f16 is the server default; q8_0/q4_0 shrink KV cache memory at some quality cost." />
                                            <TextBlock Grid.Column="2" Text="Flash attn:" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{Binding FlashAttentionOptions}"
                                                      SelectedItem="{Binding FlashAttention}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      FontSize="12"
                                                      ToolTip.Tip="--flash-attn. Auto emits no override, so llama-server selects its supported default; on/off are explicit overrides." />
                                        </Grid>
                                        <TextBlock Text="Quantized V cache may fail unless Flash Attention is explicitly on. Auto is not a controlled guarantee for this runtime."
                                                   IsVisible="{Binding NeedsFlashAttentionForQuantizedV}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <CheckBox IsChecked="{Binding ContextShift}"
                                                  Content="Context shift (rolling context for long agent loops)"
                                                  FontSize="12"
                                                  IsEnabled="{Binding CanEdit}" />
                                        <CheckBox IsChecked="{Binding PreserveReasoning}"
                                                  Content="Preserve reasoning between turns"
                                                  IsVisible="{Binding ReasoningPreserveAvailable}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  ToolTip.Tip="Replays separate reasoning content only when the selected managed model and template support it." />
                                        <TextBlock Text="{Binding ReasoningPreserveStatus}"
                                                   IsVisible="{Binding !ReasoningPreserveAvailable}"
                                                   FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                                    </StackPanel>

                                </Grid>

                                <!-- Diagnostics intentionally live below the configuration grid.
                                     A long Auto Tune/Fit explanation must never determine the height of
                                     Port, Context, or GPU Layers. -->
                                <StackPanel Margin="110,0,0,0" Spacing="3" MaxWidth="760">
                                    <TextBlock Text="{Binding ContextSourceLabel}"
                                               IsVisible="{Binding HasContextSourceLabel}"
                                               TextWrapping="Wrap"
                                               Opacity="0.5" FontSize="11" />
                                    <TextBlock Text="{Binding ContextFitNote}"
                                               IsVisible="{Binding HasContextFitWarning}"
                                               TextWrapping="Wrap"
                                               Opacity="0.7" FontSize="12" />
                                    <TextBlock Text="{Binding GpuFitBreakdown}"
                                               IsVisible="{Binding HasGpuFitBreakdown}"
                                               TextWrapping="Wrap"
                                               Opacity="0.62" FontSize="11"
                                               ToolTip.Tip="Analytical GPU Fit breakdown. Prediction only; runtime observations remain separate." />
                                </StackPanel>

                                <!-- ── Advanced engine options ───────────── -->
                                <Expander Header="Advanced engine options" IsExpanded="False">
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <CheckBox IsChecked="{Binding MemoryLock}"
                                                      Content="--mlock (keep model pinned in RAM)"
                                                      FontSize="12"
                                                      IsEnabled="{Binding CanEdit}" />
                                            <CheckBox IsChecked="{Binding NoMemoryMap}"
                                                      Content="--no-mmap"
                                                      FontSize="12"
                                                      IsEnabled="{Binding CanEdit}" />
                                        </StackPanel>

                                        <!-- Mixture-of-Experts CPU offload. A different knob
                                             from GPU layers, and the right one for a MoE model:
                                             the experts are most of the file but only a few are
                                             active per token, so keeping them in RAM leaves the
                                             GPU free for attention. Turning GPU layers down
                                             instead gives up the part that wants the GPU. -->
                                        <Grid ColumnDefinitions="200,120,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="MoE experts on CPU"
                                                       VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CpuMoeLayersText}"
                                                     Watermark="off"
                                                     FontSize="12"
                                                     CornerRadius="6"
                                                     IsEnabled="{Binding CanEdit}"
                                                     ToolTip.Tip="Blank or 0 is off. A number N keeps the MoE weights of the first N layers on the CPU (--n-cpu-moe N). &quot;all&quot; keeps every expert on the CPU (--cpu-moe). Only affects Mixture-of-Experts models; ignored by dense ones." />
                                            <TextBlock Grid.Column="2"
                                                       Text="Only affects MoE models. Lets a large MoE run with attention on the GPU and the experts in RAM, instead of cutting GPU layers to make it fit."
                                                       VerticalAlignment="Center" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                        </Grid>

                                        <!-- r27 03-drafting-and-proof.md 3.1: one composable
                                             speculative-decoding section. The spec-type flag
                                             takes a comma-separated list, and drafting and
                                             n-gram speculation are not mutually exclusive, so
                                             this replaced the single bool that owned it. -->
                                        <StackPanel Spacing="6" Margin="0,10,0,0">
                                            <TextBlock Text="Speculative decoding"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="A small model proposes the next few tokens and the large one verifies them in a single pass. The text produced is the text the large model would have produced alone. How much faster it is depends on the model pair and the content, so run the Speed Check to find out."
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Opacity="0.55" />
                                            <CheckBox IsChecked="{Binding UseNgramDecoding}"
                                                      Content="N-gram drafting (no extra VRAM)"
                                                      FontSize="12"
                                                      IsEnabled="{Binding CanEditNgramDecoding}"
                                                      ToolTip.Tip="Adds ngram-mod to --spec-type. Drafts from the prompt and history itself, so it costs no additional VRAM." />
                                            <CheckBox IsChecked="{Binding UseDraftModelDecoding}"
                                                      Content="Draft model (MTP head)"
                                                      FontSize="12"
                                                      IsEnabled="{Binding CanEditDraftModelDecoding}"
                                                      ToolTip.Tip="Adds draft-mtp to --spec-type and launches the draft model below. Costs a second, small VRAM allocation." />
                                            <TextBlock Text="{Binding RuntimeCapabilityStatus}"
                                                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <ComboBox ItemsSource="{Binding DetectedDraftModelPaths}"
                                                          SelectedItem="{Binding DraftModelPath}"
                                                          PlaceholderText="No draft model"
                                                          HorizontalAlignment="Stretch"
                                                          FontSize="12" CornerRadius="6"
                                                          IsEnabled="{Binding CanEdit}"
                                                          ToolTip.Tip="Known MTP draft heads found beside the selected model or in its MTP folder." />
                                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseDraftModelCommand}"
                                                        Padding="8,4" FontSize="11" IsEnabled="{Binding CanEdit}"
                                                        ToolTip.Tip="Choose a draft model file yourself. Hermaeus does not treat a filename as compatibility proof." />
                                                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearDraftModelCommand}"
                                                        IsVisible="{Binding HasMissingDraftModel}"
                                                        Padding="8,4" FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding DraftModelHint}"
                                                       IsVisible="{Binding HasDraftModelHint}"
                                                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding SpeculativeNMaxText}"
                                                         Watermark="n-max"
                                                         FontSize="12"
                                                         IsEnabled="{Binding CanEdit}"
                                                         ToolTip.Tip="--spec-draft-n-max: tokens to draft per step. Blank uses the server default of 3." />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SpeculativeNMinText}"
                                                         Watermark="n-min"
                                                         FontSize="12"
                                                         IsEnabled="{Binding CanEdit}"
                                                         ToolTip.Tip="--spec-draft-n-min: minimum drafted tokens. Blank uses the server default of 0." />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding SpeculativePMinText}"
                                                         Watermark="p-min"
                                                         FontSize="12"
                                                         IsEnabled="{Binding CanEdit}"
                                                         ToolTip.Tip="--spec-draft-p-min: minimum draft probability. Blank uses the server default of 0.00." />
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding DraftGpuLayersText}"
                                                         Watermark="draft ngl"
                                                         FontSize="12"
                                                         IsEnabled="{Binding CanEdit}"
                                                         ToolTip.Tip="-ngld: draft-model layers to keep in VRAM. Blank leaves the server's own default alone." />
                                            </Grid>
                                            <Grid ColumnDefinitions="200,120,*" ColumnSpacing="8"
                                                  IsVisible="{Binding HasPromptThreadsControl}">
                                                <TextBlock Text="Prompt processing threads"
                                                           VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
                                                <NumericUpDown Grid.Column="1"
                                                         Value="{Binding PromptThreads}"
                                                         Minimum="0" Maximum="128"
                                                         Increment="1"
                                                         FontSize="12"
                                                         IsEnabled="{Binding CanEdit}"
                                                         ToolTip.Tip="--threads-batch N. Uses a separate CPU count while prompt tokens are processed. Leave 0 for the runtime default; measure it with a repeatable workload before keeping a change." />
                                                <TextBlock Grid.Column="2"
                                                           Text="Shown only when the selected runtime proves --threads-batch support. It does not change generation threads."
                                                           VerticalAlignment="Center" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="{Binding DraftFitNote}"
                                                       IsVisible="{Binding HasDraftFitNote}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <Button Command="{Binding SuggestEngineSettingsCommand}"
                                                IsEnabled="{Binding CanEdit}"
                                                Content="Suggest engine settings"
                                                Padding="12,5" CornerRadius="6" FontSize="12"
                                                HorizontalAlignment="Left"
                                                ToolTip.Tip="Fills Context Size, KV cache type, and Flash Attention with a hardware-tier recommendation. Fills the editor only - nothing is saved until you click Save Config." />
                                        <TextBlock Text="{Binding SuggestEngineSettingsPreview}"
                                                   IsVisible="{Binding SuggestEngineSettingsPreview, Converter={x:Static views:NotEmptyConverter.Instance}}"
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>

                                <!-- ── Save config ───────────────────────── -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding SaveConfigCommand}"
                                            Content="Save Config"
                                            Padding="12,5" CornerRadius="6" FontSize="12" />
                                    <Button Command="{Binding AutoTuneCommand}"
                                            IsEnabled="{Binding CanEdit}"
                                            Content="Auto Tune"
                                            Padding="12,5" CornerRadius="6" FontSize="12"
                                            ToolTip.Tip="Probe llama.cpp auto-fit for this model/GPU and set the fitted GPU layer count." />
                                </StackPanel>

                                <TextBlock IsVisible="{Binding HasUnsavedChanges}"
                                           Text="Save and restart the service for these changes to affect Chat."
                                           FontSize="12" Opacity="0.55"
                                           TextWrapping="Wrap" />
                                <TextBlock IsVisible="{Binding AutoTuneStatus, Converter={x:Static views:NotEmptyConverter.Instance}}"
                                           Text="{Binding AutoTuneStatus}"
                                           FontSize="12" Opacity="0.7"
                                           TextWrapping="Wrap" />
                                <TextBlock IsVisible="{Binding ExtraArgsTrustWarning, Converter={x:Static views:NotEmptyConverter.Instance}}"
                                           Text="{Binding ExtraArgsTrustWarning}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap" />

                                <!-- ── Log panel ─────────────────────────── -->
                                <Border IsVisible="{Binding LogExpanded}"
                                        CornerRadius="6"
                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                        Padding="1">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="*,Auto"
                                              Margin="10,6,6,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="Log"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="icon-btn"
                                                    Command="{Binding ClearLogCommand}"
                                                    ToolTip.Tip="Clear log">
                                                <PathIcon Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"
                                                          Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                        <ScrollViewer Grid.Row="1"
                                                      x:Name="LogScroller"
                                                      MaxHeight="200"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto">
                                            <SelectableTextBlock
                                                Text="{Binding LogOutput}"
                                                FontFamily="{DynamicResource AppMonoFont}"
                                                FontSize="11"
                                                TextWrapping="NoWrap"
                                                Margin="10,2,10,8" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- r29 doc 01 1.1, revised: these cards edit settings that only a
                 save writes to disk, and the owner asked for the button to sit
                 with the settings it saves and to be named like the server
                 cards' own. It is still the single existing save flow; there is
                 no second serializer. Both cards save together because they
                 share it, which is why each says so. -->
            <views:ServicesVoiceSectionView DataContext="{Binding Tts}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-8,0,0">
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="Save Config"
                        Padding="12,5" CornerRadius="6" FontSize="12"
                        ToolTip.Tip="Saves the voice and speech settings on this page." />
                <TextBlock Text="Saved" IsVisible="{Binding IsSaved}"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            </StackPanel>

            <views:ServicesSttSectionView DataContext="{Binding Stt}" IsVisible="{Binding Stt, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-8,0,0"
                        IsVisible="{Binding Stt, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="Save Config"
                        Padding="12,5" CornerRadius="6" FontSize="12"
                        ToolTip.Tip="Saves the voice and speech settings on this page." />
                <TextBlock Text="Saved" IsVisible="{Binding IsSaved}"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
