<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             x:Class="Hermaeus.Desktop.Views.DesktopPetOverlay"
             x:DataType="vm:DesktopPetViewModel">
    <Canvas x:Name="PetCanvas"
            ClipToBounds="True">
        <controls:PetSprite x:Name="PetSprite"
                                   Width="96"
                                   Height="104"
                                   Package="{Binding SelectedPackage}"
                                   Canvas.Left="{Binding PositionX}"
                                   Canvas.Top="{Binding PositionY}"
                                   Cursor="Hand"
                                   ToolTip.Tip="Drag the companion to move it."
                                   PointerPressed="OnPetPointerPressed"
                                   PointerMoved="OnPetPointerMoved"
                                   PointerReleased="OnPetPointerReleased"
                                   PointerCaptureLost="OnPetPointerCaptureLost" />
    </Canvas>
</UserControl>
