<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsMemorySectionView"
             x:DataType="vm:MemorySettingsViewModel">
  <StackPanel Spacing="12">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <TextBlock Text="Chat memory" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Control whether Hermaeus stores and injects long-term memories from conversations."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable memory" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding MemoryFeatureEnabled}" Content="Remember important details across chats" FontSize="13"
                          ToolTip.Tip="Master switch for chat memory. When off, nothing below on this page has any effect." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inject memories" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding MemoryInjectIntoContext}" Content="Attach selected memories to chat context" FontSize="13"
                          ToolTip.Tip="Lets relevant saved memories be added to the prompt automatically. Off means memories are only stored, never recalled." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto-summary threshold" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MemoryImportanceThreshold}" Minimum="0" Maximum="1" Increment="0.05" FormatString="F2" FontSize="13"
                               ToolTip.Tip="Minimum importance score (0-1) a detail needs before it is saved as a memory. Higher means fewer, more significant memories." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Injection token budget" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MemoryInjectionTokenBudget}" Minimum="100" Maximum="4000" Increment="50" FontSize="13"
                               ToolTip.Tip="Maximum tokens of memory content added to a single prompt. Default 500." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Auto-archive days" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding MemoryAutoArchiveDays}" Minimum="1" Maximum="3650" Increment="1" FontSize="13"
                               ToolTip.Tip="Memories untouched for this many days are archived (hidden from recall, not deleted)." />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Agent lessons in chat" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding ConsumeAgentLessonsInChat}"
                          Content="Also inject global agent self-learning lessons into chat context (read-only, off by default)" FontSize="13"
                          ToolTip.Tip="Folds lessons the Agent learned from past tasks into chat's system prompt. Chat cannot edit or delete these lessons." />
            </Grid>
        </StackPanel>
    </Border>

    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <TextBlock Text="Recall" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Recall is a search across your conversations, agent tasks, memories and documents, reachable from Ctrl+K. Indexing keeps a searchable copy of message and task text in the data root, included in backups."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Index my history" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding RecallIndexingEnabled}"
                          Content="Index my history for Recall" FontSize="13"
                          ToolTip.Tip="Keeps a searchable copy of message and task text in the data root, included in backups. Turning this off stops indexing immediately and disables the recall half of the palette; commands still work." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Recall in chat" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding RecallInjectionEnabled}"
                          Content="Let chat retrieve from Recall and cite it (off by default)" FontSize="13"
                          ToolTip.Tip="A chat send may inject a bounded, cited block from Recall. Read-only; never blocks or rewrites a send." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Index size" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding RecallEntryCount, StringFormat='{}{0} indexed row(s)'}" VerticalAlignment="Center" FontSize="13" Opacity="0.7" />
                    <TextBlock Text="{Binding RecallIndexSizeDisplay}" VerticalAlignment="Center" FontSize="13" Opacity="0.7" />
                    <Button Content="Clear Recall index" Command="{Binding ClearRecallIndexCommand}" IsEnabled="{Binding !IsClearingRecallIndex}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
