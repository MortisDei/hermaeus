<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.LabView"
             x:DataType="vm:LabViewModel">
  <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Lab" FontSize="24" FontWeight="SemiBold" />
      <Border Classes="status-chip"><TextBlock Text="Controlled experiments" /></Border>
      <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Experiment">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8" Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="1. Compare your own baseline and candidate" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Use this when you want to test a specific change, such as context size or GPU layers. Lab freezes the current baseline, runs the candidate beside it on a dedicated loopback process, and records the evidence without changing saved Services settings. Finish or cancel the run when you have inspected the result." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="180,260" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="Configured Chat server" VerticalAlignment="Center" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <ComboBox ItemsSource="{Binding ConfiguredServers}" SelectedItem="{Binding SelectedServer}"
                          IsEnabled="{Binding HasMultipleConfiguredServers}"
                          ToolTip.Tip="One configured Chat server is selected automatically. With multiple servers, choose explicitly.">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ConfiguredServerHint}"
                           FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Experiment name" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExperimentName}" MaxLength="128" />
              <TextBlock Grid.Row="2" Text="Candidate context" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CandidateContextSize}" Minimum="128" Maximum="2097152" Increment="1024"
                             ToolTip.Tip="Candidate context size. The baseline remains the selected server's current context size." />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Start isolated run" Command="{Binding FreezeAndStartCommand}" IsEnabled="{Binding CanStartRun}"
                      ToolTip.Tip="Freeze the selected server identity and start an isolated loopback runtime." />
              <Button Content="Finish run and save baseline" Command="{Binding CompleteRunCommand}" IsEnabled="{Binding IsRunActive}"
                      ToolTip.Tip="Capture the current baseline health evidence, stop the isolated runtime, and finalize this manual run. Lab does not invent a workload or candidate result." />
              <Button Content="Cancel" Command="{Binding CancelRunCommand}" IsEnabled="{Binding IsRunActive}"
                      ToolTip.Tip="Stop the active isolated Lab runtime without changing saved Services settings." />
            </StackPanel>
            <Border Classes="card" Padding="12">
              <StackPanel Spacing="5">
                <TextBlock Text="Run state" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Execution:" />
                  <TextBlock Text="{Binding RunStatus}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Source restore:" />
                  <TextBlock Text="{Binding RestoreStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="Attention: source restore needs owner review before restarting Services."
                           IsVisible="{Binding HasRestoreFailure}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock Text="{Binding RuntimeIsolation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Expander Header="Frozen definition JSON">
              <TextBox Text="{Binding DefinitionPreview}" IsReadOnly="True" AcceptsReturn="True" MinHeight="140" FontFamily="Consolas" TextWrapping="Wrap" />
            </Expander>
            <TextBlock Text="2. Run a guided recipe" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Use a recipe when you want a ready-made runtime comparison. Each recipe changes one declared dimension, checks GPU Fit before launch, and preserves failures. Conditional controls remain Unknown until this exact runtime advertises them." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Inspect runtime recipes" Command="{Binding RefreshRecipesCommand}"
                      ToolTip.Tip="Read capabilities from the selected runtime and rebuild the bounded recipe list." />
              <Button Content="Run selected recipe" Command="{Binding RunSelectedRecipeCommand}" IsEnabled="{Binding CanRunRecipe}"
                      ToolTip.Tip="Run the selected available recipe. Unavailable capabilities remain Unknown." />
              <Button Content="Cancel recipe" Command="{Binding CancelRecipeCommand}" IsEnabled="{Binding IsRecipeRunning}"
                      ToolTip.Tip="Request cancellation of the active recipe and retain captured evidence." />
            </StackPanel>
            <ListBox ItemsSource="{Binding RecipeOptions}" SelectedItem="{Binding SelectedRecipe}" MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LabRecipeRowViewModel">
                  <Grid ColumnDefinitions="180,100,*" ColumnSpacing="8" Margin="4" ToolTip.Tip="{Binding Detail}">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding AvailabilityLabel}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding CandidateLabel}" />
                      <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox Text="{Binding RecipePrompt}" PlaceholderText="Controlled prompt" MaxLength="4096"
                     ToolTip.Tip="Recipes reconstruct the same prompt for each configuration. Prompt/shared-prefix timing compares request timing; reused-token counts stay Unknown unless directly reported by the runtime." />
            <TextBlock Text="Trade-off table" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TradeoffSummary}" FontFamily="Consolas" TextWrapping="Wrap" />
            <TextBlock Text="Apply to Services" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Apply is a separate review. It lists exact persisted fields, rejects stale runtime/model/config identity, and saves only after explicit confirmation." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Review eligible candidate" Command="{Binding ReviewApplyCommand}" IsEnabled="{Binding CanReviewCurrentRun}"
                      ToolTip.Tip="Show the exact Services fields for the current correctness-eligible Lab candidate. Nothing is saved by review." />
              <Button Content="Confirm reviewed changes" Command="{Binding ConfirmApplyCommand}"
                      ToolTip.Tip="Save only the fields shown by the reviewed candidate after explicit confirmation and identity rechecks." />
              <Button Content="Undo applied changes" Command="{Binding UndoAppliedRecommendationCommand}"
                      IsVisible="{Binding CanUndoAppliedRecommendation}"
                      ToolTip.Tip="Restore the bounded pre-Apply settings snapshot if the target has not changed since Apply." />
            </StackPanel>
            <TextBlock Text="{Binding ApplyReviewSummary}" TextWrapping="Wrap" FontFamily="Consolas" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Evidence">
        <Grid Margin="8" RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
            <ComboBox Width="180" Margin="0,0,8,8" ItemsSource="{Binding DomainOptions}" SelectedItem="{Binding DomainFilter}" />
            <ComboBox Width="145" Margin="0,0,8,8" ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding OutcomeFilter}" />
            <ComboBox Width="175" Margin="0,0,8,8" ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding OriginFilter}" />
            <ComboBox Width="135" Margin="0,0,8,8" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" PlaceholderText="Project id" Text="{Binding ProjectFilter}" />
            <TextBox Width="180" Margin="0,0,8,8" PlaceholderText="Workspace fingerprint" Text="{Binding WorkspaceFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" PlaceholderText="Model fingerprint" Text="{Binding ModelFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" PlaceholderText="Runtime fingerprint" Text="{Binding RuntimeFilter}" />
            <StackPanel Margin="0,0,8,8"><TextBlock Text="From" FontSize="11" /><DatePicker SelectedDate="{Binding CreatedFrom}" /></StackPanel>
            <StackPanel Margin="0,0,8,8"><TextBlock Text="To" FontSize="11" /><DatePicker SelectedDate="{Binding CreatedTo}" /></StackPanel>
          </WrapPanel>
          <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="14">
            <ListBox Grid.Column="0" ItemsSource="{Binding Experiences}" SelectedItem="{Binding SelectedExperience}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExperienceRowViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsExportSelected}" ToolTip.Tip="Include this record in the next evidence export" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding DisplayDomain}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding RecordKindLabel}" Opacity="0.65" />
                      <TextBlock Text="{Binding RunIdentityLabel}" Opacity="0.65" FontFamily="Consolas" />
                      <TextBlock Text="{Binding ScopeLabel}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding OriginLabel}" Opacity="0.65" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding OutcomeLabel}" />
                      <TextBlock Text="{Binding StatusLabel}" Opacity="0.65" />
                      <TextBlock Text="{Binding CreatedLabel}" Opacity="0.65" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1">
              <Grid>
                <controls:MossEmptyState IsVisible="{Binding !HasSelection}"
                                         Title="{Binding EvidenceEmptyState}"
                                         Hint="{Binding EvidenceEmptyHint}"
                                         Margin="12" />
              <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="Evidence detail" FontSize="18" FontWeight="SemiBold" />
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyEvidenceDetailCommand}"
                          ToolTip.Tip="Copy the selected Lab result, persisted evidence records, raw JSON, and provenance to the clipboard." />
                </Grid>
                <TextBlock Text="{Binding SelectedExperience.EvidenceRecordLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.Id}" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock Text="Normalized outcome" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.Outcome.Detail}" TextWrapping="Wrap" />
                <Border Classes="card" Padding="10" IsVisible="{Binding SelectedExperience.IsLabCompletionSummary}">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{Binding SelectedExperience.ResultDetails.ExperimentLabel}" FontSize="16" FontWeight="SemiBold" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4">
                      <TextBlock Text="{Binding SelectedExperience.ResultDetails.ModelLabel, StringFormat='Model: {0}'}" />
                      <TextBlock Text="{Binding SelectedExperience.ResultDetails.ResultStatus, StringFormat='Result: {0}'}" />
                      <TextBlock Text="{Binding SelectedExperience.ResultDetails.StartedLabel, StringFormat='Started: {0}'}" />
                      <TextBlock Text="{Binding SelectedExperience.ResultDetails.CompletedLabel, StringFormat='Completed: {0}'}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SelectedExperience.ResultDetails.RunIdentityLabel}" FontFamily="Consolas" Opacity="0.7" />
                    <TextBlock Text="{Binding SelectedExperience.ResultDetails.TestedConfigurations, StringFormat='Configurations: {0}'}" TextWrapping="Wrap" />
                    <Border Padding="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <TextBlock Text="{Binding SelectedExperience.ResultDetails.RecommendationLabel}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding SelectedExperience.ResultDetails.FailuresLabel, StringFormat='Failures: {0}'}"
                               IsVisible="{Binding SelectedExperience.ResultDetails.HasFailures}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding SelectedExperience.ResultDetails.EvidenceLabel}" Opacity="0.7" />
                    <TextBlock Text="Configuration comparison (baseline -&gt; candidate)" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedExperience.ResultDetails.Comparisons}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabResultComparisonViewModel">
                          <Border Padding="8" Margin="0,2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                              <TextBlock Text="Configuration" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{Binding ConfigurationLabel}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="1" Text="Throughput" Opacity="0.7" />
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThroughputLabel}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="2" Text="RAM" Opacity="0.7" />
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamLabel}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="3" Text="VRAM" Opacity="0.7" />
                              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VramLabel}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="4" Text="Correctness" Opacity="0.7" />
                              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding CorrectnessLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CorrectnessDetail}" TextWrapping="Wrap" Opacity="0.7" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <StackPanel Spacing="4" IsVisible="{Binding SelectedExperience.IsLabCompletionSummary}">
                  <TextBlock Text="Apply review" FontWeight="SemiBold" />
                  <TextBlock Text="Review the current in-memory run here. Historical evidence remains read-only and never applies settings by itself." TextWrapping="Wrap" Opacity="0.7" />
                  <Button Content="Review eligible candidate" Command="{Binding ReviewApplyCommand}" IsEnabled="{Binding CanReviewCurrentRun}"
                          ToolTip.Tip="Show the exact Services fields for the current Lab result. Review does not save anything." />
                  <Button Content="Confirm reviewed changes" Command="{Binding ConfirmApplyCommand}" IsEnabled="{Binding CanConfirmApply}"
                          ToolTip.Tip="Save only the fields shown by the reviewed candidate after explicit confirmation and identity rechecks." />
                  <Button Content="Undo applied changes" Command="{Binding UndoAppliedRecommendationCommand}"
                          IsVisible="{Binding CanUndoAppliedRecommendation}"
                          ToolTip.Tip="Restore the bounded pre-Apply settings snapshot if the target has not changed since Apply." />
                  <TextBlock Text="{Binding ApplyReviewSummary}" TextWrapping="Wrap" FontFamily="Consolas" />
                </StackPanel>
                <Expander Header="Execution evidence details">
                  <ItemsControl ItemsSource="{Binding SelectedExperience.EvidenceRecords}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Expander Header="{Binding Id}" Margin="0,2">
                          <StackPanel Spacing="4" Margin="8,4">
                            <TextBlock Text="{Binding Domain}" Opacity="0.7" />
                            <TextBlock Text="{Binding CreatedAtUtc, StringFormat='Created: {0:yyyy-MM-dd HH:mm:ss} UTC'}" Opacity="0.7" />
                            <TextBlock Text="{Binding Outcome.Detail}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ContextJson}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ActionJson}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Provenance}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Source.Title}" TextWrapping="Wrap" Opacity="0.7" /></DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                <TextBlock Text="Context" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.ContextSummary}" TextWrapping="Wrap" />
                <Expander Header="Raw context JSON">
                  <TextBox Text="{Binding SelectedExperience.Experience.ContextJson}" IsReadOnly="True"
                           AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" TextWrapping="Wrap" />
                </Expander>
                <TextBlock Text="Action or configuration" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.ActionSummary}" TextWrapping="Wrap" />
                <Expander Header="Raw action or configuration JSON">
                  <TextBox Text="{Binding SelectedExperience.Experience.ActionJson}" IsReadOnly="True"
                           AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" TextWrapping="Wrap" />
                </Expander>
                <TextBlock Text="Raw evidence links" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SelectedExperience.Experience.Provenance}">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Source.Title}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Typed correction" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding CorrectionOutcome}" />
                <TextBox Text="{Binding CorrectionDetail}" PlaceholderText="Correction detail" MaxLength="512" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save correction" Command="{Binding CorrectSelectedCommand}" />
                  <Button Content="Remove..." Command="{Binding RemoveSelectedCommand}" />
                  <Button Content="Export selected" Command="{Binding ExportSelectedCommand}" />
                </StackPanel>
                <TextBlock Text="Export JSON" FontWeight="SemiBold" />
                <TextBox Text="{Binding ExportJson}" IsReadOnly="True" AcceptsReturn="True" MinHeight="100" FontFamily="Consolas" />
              </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
