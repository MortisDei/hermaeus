<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.LabView"
             x:DataType="vm:LabViewModel">
  <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Lab" FontSize="24" FontWeight="SemiBold" />
      <Border Classes="status-chip"><TextBlock Text="Controlled experiments" /></Border>
      <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Experiment">
        <ScrollViewer>
          <StackPanel Margin="8" Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Definition" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Freeze an exact baseline and bounded candidate before launch. Lab uses a dedicated loopback process and does not edit saved Services settings." TextWrapping="Wrap" />
            <Grid ColumnDefinitions="180,260" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="Configured Chat server" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ConfiguredServers}" SelectedItem="{Binding SelectedServer}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Text="Experiment name" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExperimentName}" MaxLength="128" />
              <TextBlock Grid.Row="2" Text="Candidate context" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CandidateContextSize}" Minimum="128" Maximum="2097152" Increment="1024" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Freeze and start" Command="{Binding FreezeAndStartCommand}" IsEnabled="{Binding !IsRunActive}" />
              <Button Content="Complete baseline" Command="{Binding CompleteRunCommand}" IsEnabled="{Binding IsRunActive}" />
              <Button Content="Cancel" Command="{Binding CancelRunCommand}" IsEnabled="{Binding IsRunActive}" />
            </StackPanel>
            <Border Classes="card" Padding="12">
              <StackPanel Spacing="5">
                <TextBlock Text="Run state" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RunStatus}" />
                <TextBlock Text="{Binding RuntimeIsolation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Expander Header="Frozen definition JSON">
              <TextBox Text="{Binding DefinitionPreview}" IsReadOnly="True" AcceptsReturn="True" MinHeight="140" FontFamily="Consolas" TextWrapping="Wrap" />
            </Expander>
            <TextBlock Text="Apply to Services" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Apply is a separate review. It lists exact persisted fields, rejects stale runtime/model/config identity, and saves only after explicit confirmation." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Review candidate" Command="{Binding ReviewApplyCommand}" />
              <Button Content="Confirm reviewed changes" Command="{Binding ConfirmApplyCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ApplyReviewSummary}" TextWrapping="Wrap" FontFamily="Consolas" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Evidence">
        <Grid Margin="8" RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
            <ComboBox Width="180" Margin="0,0,8,8" ItemsSource="{Binding DomainOptions}" SelectedItem="{Binding DomainFilter}" />
            <ComboBox Width="145" Margin="0,0,8,8" ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding OutcomeFilter}" />
            <ComboBox Width="175" Margin="0,0,8,8" ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding OriginFilter}" />
            <ComboBox Width="135" Margin="0,0,8,8" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" Watermark="Project id" Text="{Binding ProjectFilter}" />
            <TextBox Width="180" Margin="0,0,8,8" Watermark="Workspace fingerprint" Text="{Binding WorkspaceFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" Watermark="Model fingerprint" Text="{Binding ModelFilter}" />
            <TextBox Width="150" Margin="0,0,8,8" Watermark="Runtime fingerprint" Text="{Binding RuntimeFilter}" />
            <StackPanel Margin="0,0,8,8"><TextBlock Text="From" FontSize="11" /><DatePicker SelectedDate="{Binding CreatedFrom}" /></StackPanel>
            <StackPanel Margin="0,0,8,8"><TextBlock Text="To" FontSize="11" /><DatePicker SelectedDate="{Binding CreatedTo}" /></StackPanel>
          </WrapPanel>
          <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="14">
            <ListBox Grid.Column="0" ItemsSource="{Binding Experiences}" SelectedItem="{Binding SelectedExperience}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExperienceRowViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsExportSelected}" ToolTip.Tip="Include this record in the next evidence export" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ScopeLabel}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding OriginLabel}" Opacity="0.65" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding OutcomeLabel}" />
                      <TextBlock Text="{Binding StatusLabel}" Opacity="0.65" />
                      <TextBlock Text="{Binding CreatedLabel}" Opacity="0.65" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1">
              <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                <TextBlock Text="Evidence detail" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.Id}" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock Text="Normalized outcome" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.Outcome.Detail}" TextWrapping="Wrap" />
                <TextBlock Text="Context" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.ContextJson}" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock Text="Action or configuration" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedExperience.Experience.ActionJson}" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock Text="Raw evidence links" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SelectedExperience.Experience.Provenance}">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Source.Title}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Typed correction" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding CorrectionOutcome}" />
                <TextBox Text="{Binding CorrectionDetail}" Watermark="Correction detail" MaxLength="512" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save correction" Command="{Binding CorrectSelectedCommand}" />
                  <Button Content="Remove..." Command="{Binding RemoveSelectedCommand}" />
                  <Button Content="Export selected" Command="{Binding ExportSelectedCommand}" />
                </StackPanel>
                <TextBlock Text="Export JSON" FontWeight="SemiBold" />
                <TextBox Text="{Binding ExportJson}" IsReadOnly="True" AcceptsReturn="True" MinHeight="100" FontFamily="Consolas" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
