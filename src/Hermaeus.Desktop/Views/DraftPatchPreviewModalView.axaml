<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hermaeus.ViewModels"
        xmlns:controls="using:Hermaeus.Desktop.Controls"
        x:Class="Hermaeus.Desktop.Views.DraftPatchPreviewModalView"
        x:DataType="vm:DraftPatchDiffViewModel"
        Title="Review Patch Changes"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
    <StackPanel Orientation="Vertical" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Review proposed patch" FontWeight="SemiBold" FontSize="16" />
        <TextBlock Text="for" Opacity="0.7" />
        <TextBlock Text="{Binding RelativePath}" FontFamily="avares://Hermaeus.Desktop/Assets/Fonts/JetBrainsMono#JetBrains Mono,Consolas,monospace" Opacity="0.8" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Text="Review the side-by-side changes below. Lines are colour-coded: green for additions, red for removals. Click Apply to queue the patch or Cancel to discard." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="6" Padding="0" Margin="0">
      <controls:DiffView DataContext="{Binding}" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="{Binding Lines.Count, StringFormat='Total lines changed: {0}'}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,8" />
        <Button Content="Apply patch" Command="{Binding ApplyCommand}" Classes="primary-btn" Padding="16,8" />
      </StackPanel>
    </Grid>
  </Grid>

</Window>
