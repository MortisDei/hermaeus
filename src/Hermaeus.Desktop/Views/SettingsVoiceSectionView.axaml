<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsVoiceSectionView"
             x:DataType="vm:TtsSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Voice orchestration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsVoiceMuted}" Content="Mute all voice" FontSize="12" />
            </Grid>
            <TextBlock Text="Hermaeus's voice now has other consumers besides the chat speak button: agent narration, Doctor warnings, benchmark completion, and system notifications. Each channel below is opt-in."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding AutoSpeakChatReplies}" Content="Automatically speak chat replies" FontSize="13" />
            <CheckBox IsChecked="{Binding StreamingChatSpeech}" IsEnabled="{Binding AutoSpeakChatReplies}"
                      Content="Experimental: speak replies sentence-by-sentence while generating" FontSize="13"
                      ToolTip.Tip="Speaks each sentence as soon as it streams in instead of waiting for the full reply; pacing between sentences can be uneven." />

            <TextBlock Text="Channels" FontSize="13" FontWeight="SemiBold" Opacity="0.8" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding VoiceChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:VoiceChannelSettingViewModel">
                        <StackPanel Margin="0,4">
                            <Grid ColumnDefinitions="140,Auto,*" ColumnSpacing="12">
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Content="{Binding DisplayName}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="Voice" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                <!-- r24: lists the active provider's own voices (the same seam
                                     RefreshTtsVoicesCommand populates TtsVoices from, prefixed
                                     with the default-voice sentinel). Avalonia's ComboBox has no
                                     free-text entry mode; AutoCompleteBox is the native
                                     editable-with-suggestions control, so typed text that matches
                                     nothing still works for providers that cannot enumerate
                                     voices (TtsVoices then holds just "default"). -->
                                <AutoCompleteBox Grid.Column="2"
                                                 ItemsSource="{Binding $parent[ItemsControl].DataContext.ChannelVoiceOptions}"
                                                 Text="{Binding VoiceDisplay, Mode=TwoWay}"
                                                 FilterMode="Contains"
                                                 FontSize="12"
                                                 HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="Spoken text is sent to the remote voice provider."
                                       FontSize="11" Opacity="0.55" Foreground="Orange" Margin="152,2,0,0"
                                       IsVisible="{Binding ShowsRemoteNotice}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
