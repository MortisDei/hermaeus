<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsVoiceSectionView"
             x:DataType="vm:TtsSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Voice orchestration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsVoiceMuted}" Content="Mute all voice" FontSize="12" />
            </Grid>
            <TextBlock Text="Hermaeus's voice now has other consumers besides the chat speak button: agent narration, Doctor warnings, benchmark completion, and system notifications. Each channel below is opt-in."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding AutoSpeakChatReplies}" Content="Automatically speak chat replies" FontSize="13" />
            <CheckBox IsChecked="{Binding StreamingChatSpeech}" IsEnabled="{Binding AutoSpeakChatReplies}"
                      Content="Experimental: speak replies sentence-by-sentence while generating" FontSize="13"
                      ToolTip.Tip="Speaks each sentence as soon as it streams in instead of waiting for the full reply; pacing between sentences can be uneven." />

            <TextBlock Text="Audio feedback" FontSize="13" FontWeight="SemiBold" Opacity="0.8" Margin="0,4,0,0" />
            <CheckBox IsChecked="{Binding AudioFeedbackEnabled}" Content="Enable supplementary audio feedback" FontSize="13" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="Volume" VerticalAlignment="Center" FontSize="12" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AudioFeedbackVolume}" />
                <TextBlock Grid.Column="2" Text="{Binding AudioFeedbackVolume, StringFormat={}{0}%}" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <CheckBox IsChecked="{Binding AudioFeedbackMuted}" Content="Mute feedback (keeps volume)" FontSize="13" />
            <CheckBox IsChecked="{Binding SuppressAudioFeedbackWhileTts}" Content="Do not play cues while TTS is speaking" FontSize="13" />
            <ItemsControl ItemsSource="{Binding AudioFeedbackEvents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AudioFeedbackToggleViewModel">
                        <CheckBox IsChecked="{Binding Enabled}" Content="{Binding DisplayName}" FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Text="Channels" FontSize="13" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh known voices" Command="{Binding RefreshTtsVoicesCommand}"
                        Padding="8,3" FontSize="11" IsEnabled="{Binding !IsRefreshingVoices}"
                        ToolTip.Tip="Refreshes the active provider's authoritative voice list for these channel selectors." />
            </Grid>
            <TextBlock Text="{Binding ChannelVoiceDiscoveryStatus}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding VoiceChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:VoiceChannelSettingViewModel">
                        <StackPanel Margin="0,4">
                            <Grid ColumnDefinitions="140,Auto,*" ColumnSpacing="12">
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Content="{Binding DisplayName}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="Voice" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                <!-- r24: lists the active provider's own voices (the same seam
                                     RefreshTtsVoicesCommand populates TtsVoices from, prefixed
                                     with the default-voice sentinel). Avalonia's ComboBox has no
                                     free-text entry mode; AutoCompleteBox is the native
                                     editable-with-suggestions control, so typed text that matches
                                     nothing still works for providers that cannot enumerate
                                     voices (TtsVoices then holds just "default"). -->
                                <!-- r29 doc 01 1.2: MinimumPrefixLength 0 plus the chevron.
                                     Without them this renders as a bare TextBox that shows
                                     nothing until the user guesses a first character, so a
                                     control whose whole job is "choose one of the provider's
                                     voices" was reported twice as a missing dropdown. -->
                                <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                                    <AutoCompleteBox Grid.Column="0"
                                                     x:Name="ChannelVoiceBox"
                                                     ItemsSource="{Binding $parent[ItemsControl].DataContext.ChannelVoiceOptions}"
                                                     Text="{Binding VoiceDisplay, Mode=TwoWay}"
                                                     FilterMode="Contains"
                                                     MinimumPrefixLength="0"
                                                     DropDownOpening="OnChannelVoiceDropDownOpening"
                                                     FontSize="12"
                                                     HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Classes="icon-btn"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Show the available voices"
                                            Click="OnShowChannelVoiceList">
                                        <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <TextBlock Text="Spoken text is sent to the remote voice provider."
                                       FontSize="11" Opacity="0.55" Foreground="Orange" Margin="152,2,0,0"
                                       IsVisible="{Binding ShowsRemoteNotice}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- r29 doc 01 1.2: factual state, not personality (docs/mascot.md).
                 The picker's usual content is the sentinel plus the placeholder
                 "default", which looks like a populated list and is not. -->
            <TextBlock Text="The selected provider has not listed named voices yet, so these pickers only offer the default. It will retry when the voice settings load or the provider changes; you can also refresh now or type a verified voice id."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       IsVisible="{Binding !ChannelVoiceOptionsAreProviderSupplied}" />
        </StackPanel>
    </Border>
</UserControl>
