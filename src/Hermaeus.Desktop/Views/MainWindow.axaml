<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hermaeus.ViewModels"
        xmlns:views="using:Hermaeus.Desktop.Views"
        xmlns:models="using:Hermaeus.Core.Models"
        xmlns:conv2="using:Avalonia.Data.Converters"
        x:Class="Hermaeus.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/hermaeus-app.png"
        MinWidth="720" MinHeight="500"
        Width="1280"   Height="820"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding Palette.OpenCommand}" />
    </Window.KeyBindings>


    <Grid ColumnDefinitions="Auto,*">

        <Border Grid.Column="0" Width="260"
                IsVisible="{Binding IsSidebarOpen}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <views:ConversationListView DataContext="{Binding}" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <Border Grid.Row="0" Padding="8,6"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                    <Button Grid.Column="0" Classes="icon-btn" Background="Transparent" Cursor="Hand"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle sidebar">
                        <PathIcon Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                                  Width="18" Height="18" />
                    </Button>

                    <!-- The buttons touch and carry the former Spacing="4" as
                         internal padding instead, so the row is one continuous
                         hand-cursor region with no dead strip between buttons.
                         Scoped here rather than changing .icon-btn globally:
                         every other icon button in the app keeps its current
                         padding. -->
                    <!-- Background AND Cursor together, and both are needed. A
                         panel with no Background is never a hit-test result, and
                         TopLevel takes the cursor from the hit element without
                         walking up to ancestors, so Cursor alone on this panel
                         (tried in r27) could never fire. With a transparent
                         background the panel is hit-testable, so the rounded
                         corners between adjacent buttons resolve to the rail
                         itself and keep the hand instead of falling through to
                         the window root, where the cursor is the default arrow.
                         That fall-through is the flicker. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="0"
                                Background="Transparent" Cursor="Hand">
                        <StackPanel.Styles>
                            <Style Selector="Button.icon-btn">
                                <Setter Property="Padding" Value="8,6" />
                            </Style>

                            <!-- Which panel you are on, readable at a glance. The
                                 icon scales through a RenderTransform rather than a
                                 Width/Height change so the row never reflows as you
                                 navigate: a layout-affecting size change would shift
                                 every button beside it and reintroduce the cursor
                                 boundary the Spacing="0" above exists to remove. -->
                            <Style Selector="Button.icon-btn.nav-active /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Style>
                            <Style Selector="Button.icon-btn.nav-active PathIcon">
                                <Setter Property="Foreground" Value="{DynamicResource BrandForestBrush}" />
                                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                                <Setter Property="RenderTransform">
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </Setter>
                            </Style>
                            <Style Selector="Button.icon-btn.nav-active TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrandForestBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Styles>

                        <Button Classes="icon-btn" Command="{Binding ShowChatPanelCommand}" Classes.nav-active="{Binding ShowChat}"
                                ToolTip.Tip="Chat">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Chat" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowAgentPanelCommand}" Classes.nav-active="{Binding ShowAgent}"
                                ToolTip.Tip="Agent - local task workbench">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M12 2 4 5v6c0 5.55 3.84 9.74 8 11 4.16-1.26 8-5.45 8-11V5l-8-3zm0 2.18L18 6.43V11c0 4.24-2.55 7.51-6 8.82C8.55 18.51 6 15.24 6 11V6.43l6-2.25zM11 7h2v5h-2V7zm0 7h2v2h-2v-2z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Agent" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowRagPanelCommand}" Classes.nav-active="{Binding ShowRag}"
                                ToolTip.Tip="RAG - ask your documents">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"
                                          Width="17" Height="17" />
                                <TextBlock Text="RAG" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowModelsPanelCommand}" Classes.nav-active="{Binding ShowModels}"
                                ToolTip.Tip="Model management">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Models" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <!-- Services / process manager -->
                        <Button Classes="icon-btn" Command="{Binding ShowServicesPanelCommand}" Classes.nav-active="{Binding ShowServices}"
                                ToolTip.Tip="Services - manage llama-server processes">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Grid>
                                    <PathIcon Data="M13 2.05v2.02c3.95.49 7 3.85 7 7.93 0 3.21-1.81 6-4.72 7.28L13 17v5h5l-1.22-1.22C19.91 19.07 22 15.76 22 12c0-5.18-3.95-9.45-9-9.95zM11 2.05C5.95 2.55 2 6.82 2 12c0 3.76 2.09 7.07 5.22 8.78L6 22h5v-5l-2.28 2.28C7.81 18 6 15.21 6 12c0-4.08 3.05-7.44 7-7.93V2.05z"
                                              Width="17" Height="17" />
                                    <!-- Running indicator dot - visible when any server is running -->
                                    <Ellipse Width="6" Height="6"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,0,-1,-1"
                                             Fill="#4CAF50"
                                             IsVisible="{Binding Services.AnyServerRunning}" />
                                </Grid>
                                <TextBlock Text="Services" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowBenchmarksPanelCommand}" Classes.nav-active="{Binding ShowBenchmarks}"
                                ToolTip.Tip="Benchmarks">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M3 17h2v-7H3v7zm4 0h2V7H7v10zm4 0h2v-4h-2v4zm4 0h2V4h-2v13zm4 0h2v-9h-2v9z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Benchmarks" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowLabPanelCommand}" Classes.nav-active="{Binding ShowLab}"
                                ToolTip.Tip="Lab - experiments and evidence">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M9 2v2h1v5.59L4.59 18A2 2 0 0 0 6.27 21h11.46a2 2 0 0 0 1.68-3L14 9.59V4h1V2H9zm3 8.17L17.73 19H6.27L12 10.17z" Width="17" Height="17" />
                                <TextBlock Text="Lab" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowSystemPanelCommand}" Classes.nav-active="{Binding ShowSystem}"
                                ToolTip.Tip="System overview">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M4 5h16v10H4V5zm0-2c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h6v2H7v2h10v-2h-3v-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2H4z"
                                          Width="17" Height="17" />
                                <TextBlock Text="System" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowDoctorPanelCommand}" Classes.nav-active="{Binding ShowDoctor}"
                                ToolTip.Tip="Hermaeus Doctor">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Grid>
                                    <PathIcon Data="M12 2a5 5 0 0 0-5 5v3H5a1 1 0 0 0-1 1v3h3v6h10v-6h3v-3a1 1 0 0 0-1-1h-2V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 1 1 6 0v3H9zm0 8v-4h6v4H9z"
                                              Width="17" Height="17" />
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,-2"
                                             Fill="#f44336"
                                             IsVisible="{Binding DoctorHasErrors}" />
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-1,-1"
                                             Fill="#FF9800"
                                             IsVisible="{Binding DoctorHasWarnings}" />
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                                             Fill="#4CAF50"
                                             IsVisible="{Binding DoctorIsOk}" />
                                </Grid>
                                <TextBlock Text="Doctor" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowMemoriesPanelCommand}" Classes.nav-active="{Binding ShowMemories}"
                                ToolTip.Tip="Memories - review, manage, and triage chat memories by conversation">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Memories" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowLogsPanelCommand}" Classes.nav-active="{Binding ShowLogs}"
                            ToolTip.Tip="Runtime logs">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M4 6h16v2H4V6zm0 4h16v2H4v-2zm0 4h10v2H4v-2z"
                                      Width="17" Height="17" />
                                <TextBlock Text="Logs" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowActivityPanelCommand}" Classes.nav-active="{Binding ShowActivity}"
                            ToolTip.Tip="Activity - what the app has been doing">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 2.05 4.95l-1.42 1.42A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Activity" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ToggleToastHistoryCommand}"
                            ToolTip.Tip="Toast notifications">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M5 4h8c2.21 0 4 1.79 4 4v6c0 2.21-1.79 4-4 4H7c-2.21 0-4-1.79-4-4V6c0-1.1.9-2 2-2zm1 2a1 1 0 0 0-1 1v6c0 .55.45 1 1 1h5.5a1.5 1.5 0 0 0 1.5-1.5V8a2 2 0 0 0-2-2H6zM8 7h3c.55 0 1 .45 1 1v2c0 .55-.45 1-1 1H8c-.55 0-1-.45-1-1V8c0-.55.45-1 1-1z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Alerts" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ToggleQuickChatCommand}"
                                ToolTip.Tip="Quick chat">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M4 4h16v10H7.17L4 17.17V4zm0-2c-1.1 0-2 .9-2 2v18l6-6h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4z"
                                          Width="17" Height="17" />
                                <TextBlock Text="Quick chat" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="icon-btn" Command="{Binding ShowSettingsPanelCommand}" Classes.nav-active="{Binding ShowSettings}"
                            ToolTip.Tip="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                  Width="17" Height="17" />
                                <TextBlock Text="Settings" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Settings.Ui.ShowNavLabels}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Resume setup"
                            Command="{Binding ResumeSetupCommand}"
                            IsVisible="{Binding ShowSetupResume}"
                            Padding="10,5" Margin="0,0,10,0"
                            ToolTip.Tip="Return to the incomplete first-run setup without losing your current step." />

                    <TextBlock Grid.Column="3"
                               Text="{Binding Chat.ConversationTitle}"
                               IsVisible="{Binding ShowChat}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" Opacity="0.5"
                               FontSize="12" MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />

                    <views:ProjectSwitcherView Grid.Column="4" DataContext="{Binding Projects}"
                                                VerticalAlignment="Center" Margin="0,0,4,0" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding ActiveViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ChatViewModel">
                        <views:ChatView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:AgentViewModel">
                        <views:AgentView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:RagViewModel">
                        <views:RagView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ModelManagementViewModel">
                        <views:ModelManagementView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ServicesViewModel">
                        <views:ServicesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:BenchmarkViewModel">
                        <views:BenchmarkView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LabViewModel">
                        <views:LabView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SystemOverviewViewModel">
                        <views:SystemOverviewView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:DoctorViewModel">
                        <views:DoctorView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:MemoriesViewModel">
                        <views:MemoriesView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:LogsViewModel">
                        <views:LogsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ActivityViewModel">
                        <views:ActivityView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SetupWizardViewModel">
                        <views:SetupWizardView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <Border Grid.Row="1"
                    IsVisible="{Binding ShowQuickChat}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="460"
                    MaxHeight="520"
                    Margin="0,0,18,18"
                    Padding="14"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="#1E1E1E">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Quick Chat"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="icon-btn"
                                Command="{Binding ToggleQuickChatCommand}"
                                ToolTip.Tip="Close quick chat">
                            <PathIcon Data="M18.3 5.71 12 12l6.3 6.29-1.41 1.41L10.59 13.41 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.29-6.3z"
                                      Width="13" Height="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Chat.Messages}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:MessageViewModel">
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="110" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Chat.InputText}"
                                 Watermark="Ask quickly..."
                                 Classes="chat-input"
                                 MinHeight="40"
                                 MaxHeight="92" />
                        <Button Grid.Column="1"
                                Command="{Binding Chat.SendCommand}"
                                Content="Send"
                                Padding="14,8"
                                CornerRadius="8" />
                    </Grid>
                </Grid>
            </Border>

            <!-- r24 doc 02 2.5: the command palette. Ctrl+K from anywhere (see Window.KeyBindings). -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    IsVisible="{Binding Palette.IsOpen}"
                    Background="#88000000">
                <Border MaxWidth="620" MaxHeight="480"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,60,0,0"
                        CornerRadius="10" Padding="0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding Palette.HasActiveProject}">
                                <ToggleButton Content="{Binding Palette.ActiveProjectName}"
                                              IsChecked="{Binding Palette.ScopeToActiveProject, Mode=TwoWay}"
                                              ToolTip.Tip="Scope results to the active project" FontSize="11" Padding="8,3" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Name="PaletteTextBox"
                                     Text="{Binding Palette.QueryText, Mode=TwoWay}"
                                     Watermark="Search everything, or type a command..."
                                     BorderThickness="0" Background="Transparent" FontSize="15"
                                     Margin="8,0" KeyDown="OnPaletteKeyDown" />
                            <Button Grid.Column="2" Classes="icon-btn" Command="{Binding Palette.CloseCommand}"
                                    ToolTip.Tip="Close palette">
                                <PathIcon Data="M18.3 5.71 12 12l6.3 6.29-1.41 1.41L10.59 13.41 4.29 19.71 2.88 18.3 9.17 12 2.88 5.71 4.29 4.29l6.3 6.3 6.29-6.3z" Width="12" Height="12" />
                            </Button>
                        </Grid>
                        <Separator Grid.Row="1" />

                        <ScrollViewer Grid.Row="2" MaxHeight="360">
                            <StackPanel Spacing="4" Margin="8">
                                <!-- Empty query: the capability index, grouped by area -->
                                <ItemsControl ItemsSource="{Binding Palette.CommandGroups}" IsVisible="{Binding Palette.IsEmptyQuery}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteCommandGroup">
                                            <StackPanel Margin="4,8,4,0" Spacing="2">
                                                <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="SemiBold" Opacity="0.5" />
                                                <ItemsControl ItemsSource="{Binding Commands}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AppCommand">
                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Command="{Binding $parent[Window].DataContext.Palette.ExecuteCommandCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Title}" FontSize="13" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.5" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontSize="10" Opacity="0.4" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Word or phrase: commands first -->
                                <StackPanel IsVisible="{Binding !Palette.IsEmptyQuery}" Spacing="2">
                                    <ItemsControl ItemsSource="{Binding Palette.MatchedCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppCommand">
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[Window].DataContext.Palette.ExecuteCommandCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Area}" FontSize="10" Opacity="0.4" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Recall results stream in underneath -->
                                    <ItemsControl ItemsSource="{Binding Palette.RecallHits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RecallHit">
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[Window].DataContext.Palette.OpenHitCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <Border Grid.Column="0" CornerRadius="4" Padding="5,1" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                            <TextBlock Text="{Binding Kind}" FontSize="9" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Snippet}" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat='{}{0:MMM d}'}" FontSize="10" Opacity="0.4" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3" Text="{Binding Palette.FooterText}" FontSize="10" Opacity="0.5"
                                   Margin="12,4" TextWrapping="Wrap"
                                   IsVisible="{Binding Palette.FooterText, Converter={x:Static conv2:StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="18,0,0,18"
                      IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToastViewModel">
                    <Border Width="360"
                            CornerRadius="8"
                            Padding="14"
                            Background="#181818"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Opacity="1">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Opacity="0.98" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding KindLabel}"
                                           FontSize="10"
                                           Opacity="0.7"
                                           Margin="8,1,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="12"
                                       Opacity="0.9"
                                       TextWrapping="Wrap" />
                            <Button Content="Copy details"
                                    IsVisible="{Binding CanCopyDetails}"
                                    HorizontalAlignment="Left"
                                    Padding="6,3"
                                    Command="{Binding $parent[ItemsControl].DataContext.CopyToastDetailsCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Copies the diagnostic detail text to the clipboard." />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Persistent toast history panel -->
        <Border Grid.ColumnSpan="2"
                IsVisible="{Binding ShowToastHistory}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,58,18,0"
                Width="420"
                MaxHeight="320"
                Padding="12"
                CornerRadius="8"
                Background="#1E1E1E"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="14" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear" Command="{Binding ClearToastHistoryCommand}" Padding="8,4" CornerRadius="6" />
                </StackPanel>
                <ScrollViewer MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding ToastHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ToastViewModel">
                                <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" Background="#1E1E1E">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding KindLabel}" Opacity="0.7" VerticalAlignment="Center" />
                                                <Button Content="Dismiss" Command="{Binding $parent[ItemsControl].DataContext.DismissToastCommand}" CommandParameter="{Binding}" Padding="6,4" CornerRadius="6" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Copy details"
                                                IsVisible="{Binding CanCopyDetails}"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                Padding="6,3"
                                                Command="{Binding $parent[ItemsControl].DataContext.CopyToastDetailsCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Copies the diagnostic detail text to the clipboard." />
                                        <TextBlock Text="{Binding TimestampLabel}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
