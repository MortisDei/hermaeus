<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.RestoreBackupConfirmationDialog"
        Title="Restore backup"
        Width="460"
        Height="230"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="18">
        <StackPanel Spacing="14">
            <TextBlock Text="Backups do not include credentials or fallback secret material. Re-enter credentials after restoring on another machine."
                       TextWrapping="Wrap" />
            <TextBlock Text="Restore will overwrite data from the backup. Continue?"
                       TextWrapping="Wrap"
                       Opacity="0.7" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        MinWidth="90"
                        Click="OnCancelClick" />
                <Button Content="Restore"
                        MinWidth="90"
                        Click="OnRestoreClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
