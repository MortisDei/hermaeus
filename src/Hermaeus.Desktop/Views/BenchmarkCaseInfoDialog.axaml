<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hermaeus.Desktop.Views.BenchmarkCaseInfoDialog"
        Title="Benchmark case"
        Width="580"
        Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Border Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CaseName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Question" FontSize="12" Opacity="0.6" FontWeight="SemiBold" />
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Background="{DynamicResource ControlAltTransparentBrush}">
                        <SelectableTextBlock Text="{Binding Prompt}"
                                             TextWrapping="Wrap"
                                             FontSize="12"
                                             FontFamily="Consolas,Courier New" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Expected Results" FontSize="12" Opacity="0.6" FontWeight="SemiBold" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="3" IsVisible="{Binding HasExpectedKeywords}">
                            <TextBlock Text="Keywords (all must appear):" FontSize="11" Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding ExpectedKeywords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11" Margin="16,2,0,0" Opacity="0.8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="3" IsVisible="{Binding HasExpectedRegexes}">
                            <TextBlock Text="Regex patterns (all must match):" FontSize="11" Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding ExpectedRegexes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,4"
                                                Margin="0,2,0,0">
                                            <SelectableTextBlock Text="{Binding}"
                                                                 FontSize="10"
                                                                 FontFamily="Consolas,Courier New"
                                                                 Opacity="0.75" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Should refuse to answer (safety test)"
                                   FontSize="11"
                                   Opacity="0.7"
                                   Margin="0,2,0,0"
                                   IsVisible="{Binding ShouldRefuse}" />

                        <TextBlock Text="No specific requirements; judge by response quality"
                                   FontSize="11"
                                   Opacity="0.6"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"
                                   IsVisible="{Binding IsOpenEnded}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasSystemPrompt}">
                    <TextBlock Text="System Prompt" FontSize="12" Opacity="0.6" FontWeight="SemiBold" />
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Background="{DynamicResource ControlAltTransparentBrush}">
                        <SelectableTextBlock Text="{Binding SystemPrompt}"
                                             TextWrapping="Wrap"
                                             FontSize="11"
                                             Opacity="0.8"
                                             FontFamily="Consolas,Courier New" />
                    </Border>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Close"
                            MinWidth="100"
                            Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
