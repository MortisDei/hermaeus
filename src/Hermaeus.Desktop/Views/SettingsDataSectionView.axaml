<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.SettingsDataSectionView"
             x:DataType="vm:DataManagementSettingsViewModel">
    <Border Classes="settings-card">
        <StackPanel Spacing="12">
            <TextBlock Text="Data Storage" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Your data, your machine: chat history, memories, RAG datasets, benchmark history, and Agent task state all live under the data folder below, nowhere else. Backup copies that folder (see the restore note below for the one exception). Deleting the data folder removes all Hermaeus state except secrets kept in your OS credential store."
                       TextWrapping="Wrap" Opacity="0.65" FontSize="11" />
            <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Data folder" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Column="1" Text="{Binding DataRootDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Default OS app data folder" FontSize="13" CornerRadius="6" Padding="10,6" />
                <Button Grid.Column="2" Classes="icon-btn" Command="{Binding OpenDataRootCommand}" ToolTip.Tip="Open data folder">
                    <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                              Width="15" Height="15" />
                </Button>
                <Button Grid.Column="3" Classes="icon-btn" Command="{Binding BrowseDataRootCommand}" ToolTip.Tip="Choose data folder">
                    <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                              Width="15" Height="15" />
                </Button>
            </Grid>
            <TextBlock Text="{Binding DataMigrationPreview}" FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="AI assets" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Column="1" Text="{Binding LocalAiAssetsRoot, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Folder containing local models, XTTS, venvs, encoders"
                         FontSize="13" CornerRadius="6" Padding="10,6" />
                <Button Grid.Column="2" Classes="icon-btn" Command="{Binding OpenLocalAiAssetsRootCommand}" ToolTip.Tip="Open AI assets folder">
                    <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                              Width="15" Height="15" />
                </Button>
                <Button Grid.Column="3" Classes="icon-btn" Command="{Binding BrowseLocalAiAssetsRootCommand}" ToolTip.Tip="Choose local AI assets folder">
                    <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                              Width="15" Height="15" />
                </Button>
            </Grid>
            <TextBlock Text="{Binding LocalAiAssetsStatus}" FontSize="11" Opacity="0.45" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="GPU build" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="180"
                          FontSize="13"
                          ItemsSource="{Binding LlamaRuntimeVariantOptions}"
                          SelectedItem="{Binding LlamaRuntimeVariant}"
                          ToolTip.Tip="Which llama.cpp build to download for install and update. Auto picks CUDA on NVIDIA, Vulkan on any other GPU, and CPU when no GPU is detected. An explicit choice always wins." />
            </Grid>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Backup to" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Column="1" Text="{Binding BackupDirectory}" Watermark="Backup folder"
                         FontSize="13" CornerRadius="6" Padding="10,6" />
                <Button Grid.Column="2" Classes="icon-btn" Command="{Binding BrowseBackupDirectoryCommand}" ToolTip.Tip="Choose backup folder">
                    <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                              Width="15" Height="15" />
                </Button>
            </Grid>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Restore" VerticalAlignment="Center" Opacity="0.6" FontSize="13" />
                <TextBox Grid.Column="1" Text="{Binding RestoreBackupPath}" Watermark="hermaeus-backup.zip"
                         FontSize="13" CornerRadius="6" Padding="10,6" />
                <Button Grid.Column="2" Classes="icon-btn" Command="{Binding BrowseRestoreBackupCommand}" ToolTip.Tip="Choose backup zip">
                    <PathIcon Data="M16 6v8h3l-4 4-4-4h3V6h2zM5 20h14v-2H5v2z" Width="15" Height="15" />
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding BackupDataCommand}" Content="Backup Now" FontSize="12" Padding="12,5" CornerRadius="6" />
                <Button Command="{Binding RestoreDataCommand}" Content="Restore" FontSize="12" Padding="12,5" CornerRadius="6" />
            </StackPanel>
            <TextBlock Text="Restore warning: backups do not include credentials or fallback secret material. Re-enter credentials after restoring on another machine."
                       TextWrapping="Wrap"
                       Opacity="0.65"
                       FontSize="11" />
            <TextBlock Text="{Binding SettingsError}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
