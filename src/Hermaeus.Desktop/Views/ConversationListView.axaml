<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             x:Class="Hermaeus.Desktop.Views.ConversationListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- ── Top actions ────────────────────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,8,0,4">
            <Button Classes="sidebar-new" Command="{Binding NewConversationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="15" Height="15" />
                    <TextBlock Text="New Chat" FontSize="13" />
                </StackPanel>
            </Button>

            <Border Margin="8,2" CornerRadius="6"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery}"
                             Watermark="Search…"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,6" FontSize="13" />
                    <PathIcon Grid.Column="1"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Width="14" Height="14" Margin="0,0,8,0" Opacity="0.4" />
                </Grid>
            </Border>

            <ComboBox ItemsSource="{Binding FolderFilters}"
                      SelectedItem="{Binding SelectedFolderFilter}"
                      Margin="8,2"
                      FontSize="12"
                      MinHeight="30"
                      ToolTip.Tip="Folder filter" />

            <CheckBox Content="Show archived"
                      IsChecked="{Binding ShowArchivedConversations}"
                      Margin="12,0,8,2"
                      FontSize="11"
                      Opacity="0.65" />
        </StackPanel>

        <!-- ── Conversations ──────────────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="ConvList"
                     ItemsSource="{Binding Conversations}"
                     Background="Transparent"
                     Padding="4,0"
                     SelectionMode="Single"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="0,1" />
                    </ControlTheme>
                </ListBox.ItemContainerTheme>

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Pin" Click="OnContextMenuPinClick" />
                        <MenuItem Header="Archive" Click="OnContextMenuArchiveClick" />
                        <MenuItem Header="Exclude from Recall" Click="OnContextMenuRecallExclusionClick" />
                        <Separator />
                        <MenuItem Header="Export Markdown" Click="OnContextMenuExportMarkdownClick" />
                        <MenuItem Header="Export JSON" Click="OnContextMenuExportJsonClick" />
                        <Separator />
                        <MenuItem Header="Delete" Click="OnContextMenuDeleteClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ConversationItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="M16 9V4l1-1V2H7v1l1 1v5l-2 2v1h5v8l1 1 1-1v-8h5v-1l-2-2z"
                                                  Width="11" Height="11"
                                                  Opacity="0.7"
                                                  IsVisible="{Binding IsPinned}" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TimeDisplay}"
                                               FontSize="10"
                                               Opacity="0.42"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FolderDisplay}"
                                               FontSize="10"
                                               Opacity="0.44"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TagsDisplay}"
                                               FontSize="10"
                                               Classes="faint"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="icon-btn"
                                    ToolTip.Tip="Conversation details"
                                    VerticalAlignment="Top"
                                    x:Name="DetailsButton">
                                <PathIcon Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                          Width="14" Height="14" Opacity="0.62" />
                                <Button.Flyout>
                                    <Flyout Placement="RightEdgeAlignedTop">
                                        <Border Width="280" Padding="12" Classes="settings-card">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Conversation" FontWeight="SemiBold" FontSize="14" />
                                                <TextBox Text="{Binding Title, Mode=TwoWay}"
                                                         Watermark="Title"
                                                         CornerRadius="6"
                                                         Padding="10,6" />
                                                <TextBox Text="{Binding Folder, Mode=TwoWay}"
                                                         Watermark="Folder"
                                                         CornerRadius="6"
                                                         Padding="10,6" />
                                                <TextBox Text="{Binding TagsText, Mode=TwoWay}"
                                                         Watermark="tags, comma separated"
                                                         CornerRadius="6"
                                                         Padding="10,6" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0"
                                                            Content="{Binding PinActionLabel}"
                                                            Click="OnDetailsPinClick" />
                                                    <Button Grid.Column="1"
                                                            Content="{Binding ArchiveActionLabel}"
                                                            Click="OnDetailsArchiveClick" />
                                                </Grid>
                                                <Button Content="{Binding RecallExclusionActionLabel}"
                                                        HorizontalAlignment="Stretch"
                                                        Click="OnDetailsRecallExclusionClick" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0"
                                                            Content="Export MD"
                                                            Click="OnDetailsExportMarkdownClick" />
                                                    <Button Grid.Column="1"
                                                            Content="Export JSON"
                                                            Click="OnDetailsExportJsonClick" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Button Grid.Column="1"
                                                            Classes="icon-btn"
                                                            Click="OnDetailsDeleteClick"
                                                            ToolTip.Tip="Deletes this conversation and its messages. Cannot be undone.">
                                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                  Width="13" Height="13" Opacity="0.65" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>
