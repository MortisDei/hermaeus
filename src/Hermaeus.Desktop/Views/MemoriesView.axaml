<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             x:Class="Hermaeus.Desktop.Views.MemoriesView"
             x:Name="Root"
             x:DataType="vm:MemoriesViewModel">

    <ScrollViewer Padding="24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Spacing="16">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Chat Memories" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Review, search, pin, and manage stored memories from conversations." FontSize="13" Opacity="0.5" />
            </StackPanel>

            <!-- Embedding mismatch banner (r16 02-memory-integrity.md 2.4) -->
            <Border Classes="settings-card" Padding="14" IsVisible="{Binding HasEmbeddingMismatch}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               Text="{Binding EmbeddingMismatchLabel}"
                               FontSize="12" VerticalAlignment="Center"
                               ToolTip.Tip="These memories were embedded with a different model, so their semantic recall score is 0 until re-embedded." />
                    <Button Grid.Column="1"
                            Content="Re-embed memories"
                            Command="{Binding ReembedMismatchedCommand}"
                            IsEnabled="{Binding !IsReembedding}"
                            FontSize="12" Padding="10,8"
                            ToolTip.Tip="Clears the stale embeddings and re-embeds them with the current model in the background." />
                </Grid>
            </Border>

            <!-- Search & Filter Bar -->
            <Border Classes="settings-card" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                        <!-- Search Input -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Search memories" FontSize="12" Opacity="0.6" />
                            <TextBox Text="{Binding SearchText}"
                                     PlaceholderText="Search by content, tags, category..."
                                     FontSize="12" Padding="10,8"
                                     ToolTip.Tip="Matches memory content, tags, and category as you type." />
                        </StackPanel>

                        <!-- Category Filter -->
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Filter by category" FontSize="12" Opacity="0.6" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      FontSize="12"
                                      ToolTip.Tip="Shows only memories saved under this category." />
                        </StackPanel>
                    </Grid>

                    <!-- Conversation Filter (per-conversation memory triage) -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Filter by conversation" FontSize="12" Opacity="0.6" />
                            <ComboBox ItemsSource="{Binding ConversationFilters}"
                                      SelectedItem="{Binding SelectedConversationFilter}"
                                      PlaceholderText="All conversations"
                                      FontSize="12" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Shows only memories created from this conversation.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ConversationFilterItemViewModel">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Bottom">
                            <Button Content="Clear"
                                    Command="{Binding ClearConversationFilterCommand}"
                                    FontSize="12" Padding="10,8"
                                    ToolTip.Tip="Resets the conversation filter to show memories from every conversation." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="6" VerticalAlignment="Bottom">
                            <Button Content="Export CSV"
                                    Command="{Binding ExportConversationCsvCommand}"
                                    FontSize="12" Padding="10,8"
                                    ToolTip.Tip="Exports the currently filtered memories to a CSV file." />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Vertical" Spacing="6" VerticalAlignment="Bottom">
                            <Button Content="Export history"
                                    Command="{Binding ExportMemoryHistoryJsonCommand}"
                                    FontSize="12" Padding="10,8"
                                    ToolTip.Tip="Exports the visible memories with versioned revisions, sources, decisions, and effective times." />
                        </StackPanel>
                    </Grid>

                    <!-- Status -->
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total memories: {0}'}"
                               FontSize="11" Opacity="0.5" />
                </StackPanel>
            </Border>

            <!-- Memories List -->
            <Border CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Memories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MemoryItemViewModel">
                                <Border Padding="12" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                                        <!-- Content Section -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Spacing="4">
                                            <!-- Category & Created -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding CategoryDisplay}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Opacity="0.7" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ImportanceDisplay}"
                                                           FontSize="11"
                                                           Opacity="0.5" />
                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,1"
                                                        IsVisible="{Binding IsPinned}"
                                                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                        ToolTip.Tip="This memory is pinned. Pinned memories are weighted higher and are never auto-archived.">
                                                    <TextBlock Text="{Binding PinStateLabel}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding CreatedDisplay}"
                                                           FontSize="10"
                                                           Opacity="0.4" />
                                            </Grid>

                                            <!-- Memory Content.
                                                 The Foreground was bound to a DynamicResource
                                                 "TextFillColorPrimaryBrush", which is a WinUI key that
                                                 Avalonia's Fluent theme does not define and that appeared
                                                 nowhere else in this app. The lookup failed, the brush fell
                                                 back to black, and every memory's text was invisible against
                                                 the dark theme while still reserving its full height. Inherit
                                                 the foreground like every sibling TextBlock here does. -->
                                            <TextBlock Text="{Binding Content}"
                                                       FontSize="13" TextWrapping="Wrap" />

                                            <!-- Tags -->
                                            <TextBlock Text="{Binding Tags}"
                                                       FontSize="10" Opacity="0.5" />

                                            <!-- Recall stats -->
                                            <TextBlock Text="{Binding RecallDisplay}"
                                                       FontSize="10" Opacity="0.4" />
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                    Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <!-- Pin Button -->
                                            <Button x:Name="PinButton"
                                                    Command="{Binding #Root.DataContext.TogglePinCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Content="{Binding PinButtonLabel}"
                                                    FontSize="11" Padding="8,5" CornerRadius="6"
                                                    ToolTip.Tip="Pinned memories are weighted higher and are never auto-archived." />

                                            <!-- Delete Button -->
                                            <Button Command="{Binding #Root.DataContext.DeleteMemoryCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Content="Delete"
                                                    FontSize="11" Padding="8,5" CornerRadius="6"
                                                    ToolTip.Tip="Permanently deletes this memory. This cannot be undone." />

                                            <Button Command="{Binding #Root.DataContext.InspectMemoryCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Content="History"
                                                    FontSize="11" Padding="8,5" CornerRadius="6"
                                                    ToolTip.Tip="Inspect this memory's revision timeline and explicit review actions." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- R32 assertion lineage review -->
            <Border Classes="settings-card" Padding="14" IsVisible="{Binding HasSelectedMemory}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Memory revision review" FontSize="15" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Close" Command="{Binding ClearMemoryInspectionCommand}"
                                FontSize="11" Padding="8,5"
                                ToolTip.Tip="Close the revision timeline." />
                    </Grid>
                    <TextBlock Text="{Binding SelectedMemory.Content}" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Text="Draft a new fact revision. Presentation changes such as pinning stay separate."
                               FontSize="11" Opacity="0.6" />
                    <TextBox Text="{Binding RevisionDraftContent}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             IsEnabled="{Binding !IsRevisionBusy}"
                             ToolTip.Tip="The text saved by Revise or Correct becomes a new immutable content revision." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Revise fact" Command="{Binding ReviseSelectedCommand}"
                                IsEnabled="{Binding !IsRevisionBusy}"
                                ToolTip.Tip="Create a successor revision while retaining the previous evidence." />
                        <Button Content="Correct fact" Command="{Binding CorrectSelectedCommand}"
                                IsEnabled="{Binding !IsRevisionBusy}"
                                ToolTip.Tip="Create an explicit correction without inventing effective time." />
                        <Button Content="Mark disputed" Command="{Binding MarkSelectedDisputedCommand}"
                                IsEnabled="{Binding !IsRevisionBusy}"
                                ToolTip.Tip="Keep the revision but exclude it from ordinary memory injection until reviewed." />
                    </StackPanel>
                    <TextBlock Text="Revision timeline" FontSize="13" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding RevisionTimeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MemoryRevisionItemViewModel">
                                <Border Padding="10" Margin="0,0,0,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                            <Button Grid.Column="1" Content="Restore as new revision"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RestoreRevisionCommand}"
                                                    CommandParameter="{Binding RevisionId}"
                                                    IsEnabled="{Binding !$parent[ItemsControl].DataContext.IsRevisionBusy}"
                                                    FontSize="10" Padding="7,4"
                                                    ToolTip.Tip="Create a new current revision from this historical content. It never promotes history in place." />
                                        </Grid>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding DiffDisplay}" TextWrapping="Wrap" FontSize="10" Opacity="0.65" />
                                        <TextBlock Text="{Binding RecordedDisplay}" FontSize="10" Opacity="0.55" />
                                        <TextBlock Text="{Binding EffectiveDisplay}" FontSize="10" Opacity="0.55" />
                                        <TextBlock Text="{Binding Sources, StringFormat='Sources: {0}'}" FontSize="10" Opacity="0.55" />
                                        <TextBlock Text="{Binding Decision, StringFormat='Decision: {0}'}" TextWrapping="Wrap" FontSize="10" Opacity="0.55" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator />
                    <TextBlock Text="Contradiction review" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Select another visible memory to record a review-only proposal. Neither revision changes until an explicit decision is made."
                               TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
                    <ComboBox ItemsSource="{Binding Memories}"
                              SelectedItem="{Binding ContradictionTarget}"
                              PlaceholderText="Select another memory"
                              IsEnabled="{Binding !IsRevisionBusy}"
                              ToolTip.Tip="Select the second exact current assertion for a bounded contradiction review.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:MemoryItemViewModel">
                                <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding ContradictionExplanation}"
                             PlaceholderText="Why do these two assertions appear incompatible?"
                             IsEnabled="{Binding !IsRevisionBusy}"
                             ToolTip.Tip="Describe the suspected contradiction. This records a proposal and does not change either assertion." />
                    <Button Content="Record contradiction proposal"
                            Command="{Binding ProposeContradictionCommand}"
                            IsEnabled="{Binding !IsRevisionBusy}"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="Record a review-only proposal with the two exact revision identities." />
                    <ItemsControl ItemsSource="{Binding ContradictionProposals}"
                                  IsVisible="{Binding HasContradictionProposals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:KnowledgeContradictionProposalViewModel">
                                <Border Padding="10" Margin="0,0,0,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LeftRevision, StringFormat='Left: {0}'}" TextWrapping="Wrap" FontSize="10" />
                                        <TextBlock Text="{Binding RightRevision, StringFormat='Right: {0}'}" TextWrapping="Wrap" FontSize="10" />
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding SourceComparison}" TextWrapping="Wrap" FontSize="10" Opacity="0.6" />
                                        <TextBlock Text="{Binding EffectiveTimeComparison}" TextWrapping="Wrap" FontSize="10" Opacity="0.6" />
                                        <TextBlock Text="{Binding MissingEvidence, StringFormat='Missing evidence: {0}'}" TextWrapping="Wrap" FontSize="10" Opacity="0.6" />
                                        <Button Content="Reject proposal"
                                                Command="{Binding $parent[ItemsControl].DataContext.RejectContradictionProposalCommand}"
                                                CommandParameter="{Binding ProposalId}"
                                                IsEnabled="{Binding !$parent[ItemsControl].DataContext.IsRevisionBusy}"
                                                HorizontalAlignment="Left" FontSize="10" Padding="7,4"
                                                ToolTip.Tip="Reject this proposal without changing either exact revision." />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <controls:MossEmptyState HorizontalAlignment="Center" VerticalAlignment="Center"
                        Title="No memories yet"
                        Hint="Memories build up automatically as you chat: the model saves facts and preferences worth remembering later."
                        IsVisible="{Binding HasNoMemories}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
