<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hermaeus.Desktop</RootNamespace>
    <AssemblyName>Hermaeus.Desktop</AssemblyName>
    <ApplicationIcon>Assets/hermaeus.ico</ApplicationIcon>
    <!-- Avalonia 11 used reflection bindings by default; retain that established binding model until views are explicitly typed. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia"               Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit"  Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop"       Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter"   Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Markdig"                Version="0.38.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hermaeus.Core/Hermaeus.Core.csproj" />
    <ProjectReference Include="../Hermaeus.Agent/Hermaeus.Agent.csproj" />
    <ProjectReference Include="../Hermaeus.Services/Hermaeus.Services.csproj" />
    <ProjectReference Include="../Hermaeus.ViewModels/Hermaeus.ViewModels.csproj" />
    <ProjectReference Include="../Hermaeus.Rag/Hermaeus.Rag.csproj" />
    <ProjectReference Include="../Hermaeus.Mcp/Hermaeus.Mcp.csproj" />
    <ProjectReference Include="../Hermaeus.Composition/Hermaeus.Composition.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="Styles/**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\README.md" Link="BundledHelp\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\features.md" Link="BundledHelp\features.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\user-guide.md" Link="BundledHelp\user-guide.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\rag.md" Link="BundledHelp\rag.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\agent.md" Link="BundledHelp\agent.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\voice.md" Link="BundledHelp\voice.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hermaeus.Tests" />
  </ItemGroup>
</Project>
