<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hermaeus.ViewModels"
             xmlns:controls="using:Hermaeus.Desktop.Controls"
             xmlns:core="using:Hermaeus.Core.Models"
             xmlns:services="using:Hermaeus.Core.Services"
             xmlns:conv="using:Hermaeus.Desktop.Views"
             x:Class="Hermaeus.Desktop.Controls.MessageControl"
             x:Name="Root"
             x:DataType="vm:MessageViewModel">

    <UserControl.Resources>
        <!-- r25 doc 01 1.5: shown only on a message that actually has siblings, so
             an unbranched conversation gains no chrome at all. The arrows read as
             icons and carry tooltips; the count is plain text, not a menu. -->
        <DataTemplate x:Key="BranchSwitcherTemplate" DataType="vm:MessageViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasSiblings}">
                <Button Classes="icon-btn"
                        Opacity="0.45"
                        ToolTip.Tip="Previous version"
                        Command="{Binding $parent[ItemsControl].DataContext.PreviousBranchCommand}"
                        CommandParameter="{Binding}">
                    <PathIcon Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="10" Height="10" />
                </Button>
                <TextBlock Text="{Binding BranchLabel}"
                           FontSize="10"
                           Opacity="0.45"
                           VerticalAlignment="Center" />
                <Button Classes="icon-btn"
                        Opacity="0.45"
                        ToolTip.Tip="Next version"
                        Command="{Binding $parent[ItemsControl].DataContext.NextBranchCommand}"
                        CommandParameter="{Binding}">
                    <PathIcon Data="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Width="10" Height="10" />
                </Button>
                <Button Classes="icon-btn"
                        Opacity="0.45"
                        ToolTip.Tip="Delete this version"
                        Command="{Binding $parent[ItemsControl].DataContext.DeleteBranchCommand}"
                        CommandParameter="{Binding}">
                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                              Width="10" Height="10" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ── User bubble ────────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding IsUser}"
                    HorizontalAlignment="Right"
                    MaxWidth="680"
                    Margin="60,0,0,0"
                    Spacing="2">
            <Border CornerRadius="14,14,2,14"
                    Padding="14,10"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <Grid>
                    <SelectableTextBlock Text="{Binding Content}"
                                         IsVisible="{Binding !IsEditing}"
                                         TextWrapping="Wrap"
                                         FontSize="{DynamicResource AppChatFontSize}"
                                         LineHeight="22"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />

                    <!-- r25 doc 01 1.4: editing sends a SIBLING of this message; the
                         original and everything under it stays reachable through the
                         switcher below. -->
                    <StackPanel IsVisible="{Binding IsEditing}" Spacing="6">
                        <TextBox Text="{Binding EditText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinWidth="320"
                                 MaxHeight="220"
                                 FontSize="{DynamicResource AppChatFontSize}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Padding="10,4"
                                    CornerRadius="6"
                                    Command="{Binding $parent[ItemsControl].DataContext.CancelEditMessageCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Send as new version"
                                    Padding="10,4"
                                    CornerRadius="6"
                                    Classes="accent"
                                    Command="{Binding $parent[ItemsControl].DataContext.SubmitEditMessageCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- r27 01 1.4: submitted while the chat server was still loading a
                 model. Nothing has been sent; cancelling gives the text back. -->
            <StackPanel IsVisible="{Binding IsHeld}"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0">
                <TextBlock Text="{Binding HeldReason}"
                           FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                <Button Content="Cancel"
                        FontSize="11"
                        Padding="8,2"
                        ToolTip.Tip="Discard this held message and put its text back in the box"
                        Command="{Binding $parent[ItemsControl].DataContext.CancelHeldMessageCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="2" Background="Transparent" Cursor="Hand"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding !IsEditing}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource BranchSwitcherTemplate}" />
                <Button Classes="icon-btn"
                        Opacity="0.45"
                        ToolTip.Tip="Edit and send as a new version"
                        Command="{Binding $parent[ItemsControl].DataContext.BeginEditMessageCommand}"
                        CommandParameter="{Binding}">
                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                              Width="11" Height="11" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ── Assistant message ─────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding IsAssistant}"
                    HorizontalAlignment="Left"
                    MaxWidth="780"
                    Margin="0,0,60,0">

            <!-- r19 6.5: the assistant side previously had no visible container at
                 all (flat text floating in the transcript); this border is kept
                 transparent so it reads as a subtle outline, not a second bubble
                 style competing with the user's filled one. The copy/speak/meta
                 row below stays OUTSIDE so 6.3's stick-to-bottom math is unaffected. -->
            <Border CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="Transparent"
                    Padding="14,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                        <PathIcon Data="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-1H1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7.5 13A2.5 2.5 0 0 0 5 15.5A2.5 2.5 0 0 0 7.5 18a2.5 2.5 0 0 0 2.5-2.5A2.5 2.5 0 0 0 7.5 13m9 0a2.5 2.5 0 0 0-2.5 2.5a2.5 2.5 0 0 0 2.5 2.5a2.5 2.5 0 0 0 2.5-2.5A2.5 2.5 0 0 0 16.5 13z"
                              Width="13" Height="13"
                              Classes.thinking-pulse="{Binding IsStreaming}">
                            <PathIcon.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                        <TextBlock Text="Assistant" FontSize="11" Opacity="0.4"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock IsVisible="{Binding IsStreaming}"
                                   Text="●" FontSize="9"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <TextBlock IsVisible="{Binding HasStreamingStatus}"
                                   Text="{Binding StreamingStatus}"
                                   FontSize="11" Opacity="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasReasoning}" Spacing="4" Margin="0,0,0,8">
                        <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      Padding="8,3"
                                      CornerRadius="8"
                                      ToolTip.Tip="Show or hide the separate reasoning content">
                            <TextBlock Text="{Binding IsReasoningStreaming, Converter={x:Static conv:BoolToTextConverter.Instance}, ConverterParameter='Thinking|Reasoning'}"
                                       FontSize="11" />
                        </ToggleButton>
                        <Border IsVisible="{Binding IsReasoningExpanded}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Padding="10,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Reasoning" FontSize="10" Opacity="0.55" FontWeight="SemiBold" />
                                <controls:MarkdownViewer Markdown="{Binding ReasoningContent}"
                                                          RequestCopyToClipboard="{Binding $parent[ItemsControl].DataContext.RequestCopyToClipboard}"
                                                          FontSize="{DynamicResource AppChatFontSize}" />
                                <Button Content="Copy reasoning"
                                        HorizontalAlignment="Left"
                                        Padding="8,3"
                                        ToolTip.Tip="Copy reasoning without copying the answer"
                                        Command="{Binding $parent[ItemsControl].DataContext.CopyReasoningCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding NoFinalAnswerNotice}"
                               IsVisible="{Binding NoFinalAnswerNotice, Converter={x:Static conv:NotEmptyConverter.Instance}}"
                               FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                    <controls:MarkdownViewer Markdown="{Binding Content}"
                                             IsError="{Binding IsError}"
                                             RequestCopyToClipboard="{Binding $parent[ItemsControl].DataContext.RequestCopyToClipboard}"
                                             RequestSaveCodeBlock="{Binding $parent[ItemsControl].DataContext.SaveCodeBlockAction}"
                                             FontSize="{DynamicResource AppChatFontSize}" />

                    <!-- r19 1.2: generation stopped at the token cap, not because the
                         model finished naturally; say so and offer to keep going. -->
                    <StackPanel IsVisible="{Binding WasTruncated}"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,4,0,0">
                        <TextBlock Text="{Binding TruncationNotice}"
                                   FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                        <Button Content="Continue"
                                FontSize="11"
                                Padding="8,2"
                                Command="{Binding $parent[ItemsControl].DataContext.ContinueTruncatedCommand}" />
                    </StackPanel>

                    <!-- r25 doc 02: one receipt for everything injected into this turn.
                         Replaces the always-visible citation strip plus the separately
                         collapsed memory pill, which between them meant collapsing the
                         memory pill hid nothing once r24's Recall pills started landing
                         in the citation strip above it. Collapsed means no source item
                         is visible at all. -->
                    <StackPanel IsVisible="{Binding HasContext}" Spacing="4" Margin="0,6,0,0">
                        <ToggleButton IsChecked="{Binding IsContextExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      Padding="8,3"
                                      CornerRadius="10"
                                      Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                      BorderThickness="0"
                                      ToolTip.Tip="What went into this answer">
                            <TextBlock FontSize="11" Opacity="0.6" Text="{Binding ContextSummary}" />
                        </ToggleButton>

                        <ItemsControl ItemsSource="{Binding ContextSections}"
                                      IsVisible="{Binding IsContextExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:ChatContextReceiptSection">
                                    <StackPanel Margin="0,4,0,0" Spacing="2">
                                        <TextBlock FontSize="10"
                                                   Opacity="0.45"
                                                   Text="{Binding Label}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="core:SourceReference">
                                                    <!-- r19 6.1: the pill shows only the keyword-extracted
                                                         Title; a click opens a flyout with the actual
                                                         content. Carried over unchanged from the memory
                                                         pill, and now available for every source kind. -->
                                                    <Button CornerRadius="10"
                                                            Margin="0,0,6,4"
                                                            Padding="8,3"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            BorderThickness="0">
                                                        <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Title}" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="Top">
                                                                <StackPanel Width="320" Spacing="8">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <SelectableTextBlock Text="{Binding Snippet}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                                                                    <Button Content="Open in Memories"
                                                                            HorizontalAlignment="Left"
                                                                            Padding="8,4"
                                                                            CornerRadius="6"
                                                                            IsVisible="{Binding Kind, Converter={x:Static conv:ProvenanceConverters.IsMemory}}"
                                                                            Command="{Binding #Root.OpenMemoryCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- r29 doc 01 1.3: 6px padding around a 12-13px icon gives roughly a
                 24px square, which is a small target for the most-used controls
                 in the app. Scoped to this row rather than to .icon-btn globally,
                 which would resize every icon button in every panel. -->
            <Grid Margin="0,4,0,0" ColumnDefinitions="Auto,*">
                <Grid.Styles>
                    <Style Selector="Button.icon-btn">
                        <Setter Property="MinWidth" Value="28" />
                        <Setter Property="MinHeight" Value="28" />
                    </Style>
                </Grid.Styles>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Background="Transparent" Cursor="Hand">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource BranchSwitcherTemplate}" />
                    <Button Classes="icon-btn"
                            Opacity="0.45"
                            ToolTip.Tip="Copy"
                            Command="{Binding $parent[ItemsControl].DataContext.CopyMessageCommand}"
                            CommandParameter="{Binding}">
                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                  Width="12" Height="12" />
                    </Button>
                    <!-- r19 4.4: the speak icon becomes a stop icon while this channel is
                         playing (any message, not just this one - only one utterance ever
                         plays at a time) so the user always has a way to stop it. -->
                    <Button Classes="icon-btn"
                            Opacity="0.45"
                            ToolTip.Tip="Read aloud"
                            IsVisible="{Binding !$parent[ItemsControl].DataContext.IsVoicePlaying}"
                            Command="{Binding $parent[ItemsControl].DataContext.SpeakMessageCommand}"
                            CommandParameter="{Binding}">
                        <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.5 4.5 0 0 0 16.5 12zm-2.5-8.5v2.06A7 7 0 0 1 14 18.44v2.06A9 9 0 0 0 14 3.5z"
                                  Width="13" Height="13" />
                    </Button>
                    <Button Classes="icon-btn"
                            Opacity="0.45"
                            ToolTip.Tip="Stop"
                            IsVisible="{Binding $parent[ItemsControl].DataContext.IsVoicePlaying}"
                            Command="{Binding $parent[ItemsControl].DataContext.StopSpeakingCommand}">
                        <PathIcon Data="M6 6h12v12H6z"
                                  Width="13" Height="13" />
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding MetaDisplay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="12,0,0,2"
                           FontSize="11"
                           Classes="faint"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
