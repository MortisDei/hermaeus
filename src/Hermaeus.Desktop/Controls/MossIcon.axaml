<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hermaeus.Desktop.Controls.MossIcon"
             Width="16" Height="16">
  <!--
    Icon-scale rendering of the "Moss" mascot per docs/mascot.md: round
    face silhouette, pointed ears, a mushroom tuft, two big eyes. Plain
    vector shapes only (no image/SVG dependency) so it scales cleanly at
    any size this control is placed at.
  -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Ellipse Canvas.Left="2" Canvas.Top="9" Width="4" Height="6" Fill="#436B3F" />
      <Ellipse Canvas.Left="18" Canvas.Top="9" Width="4" Height="6" Fill="#436B3F" />
      <Ellipse Canvas.Left="3" Canvas.Top="6" Width="18" Height="15" Fill="#7A8F6A" />
      <Rectangle Canvas.Left="11" Canvas.Top="3" Width="2" Height="4" Fill="#E8DFC6" />
      <Ellipse Canvas.Left="8.5" Canvas.Top="1" Width="4" Height="3" Fill="#B87333" />
      <Ellipse Canvas.Left="12.5" Canvas.Top="2" Width="3" Height="2.4" Fill="#D19A42" />
      <Ellipse Canvas.Left="7.5" Canvas.Top="12" Width="3.2" Height="4" Fill="#1A1D18" />
      <Ellipse Canvas.Left="13.3" Canvas.Top="12" Width="3.2" Height="4" Fill="#1A1D18" />
      <Ellipse Canvas.Left="8.1" Canvas.Top="12.6" Width="1" Height="1" Fill="#E8DFC6" />
      <Ellipse Canvas.Left="13.9" Canvas.Top="12.6" Width="1" Height="1" Fill="#E8DFC6" />
    </Canvas>
  </Viewbox>
</UserControl>
