<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Hermaeus.Desktop.Converters"
             x:Class="Hermaeus.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Hermaeus.Desktop/Styles/AppStyles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <conv:UppercaseConverter x:Key="UppercaseConverter" />

        <!-- Brand fonts (docs/mascot.md / docs/hermaeus-branding.png). Embedded so
             the look is identical regardless of what's installed on the host. -->
        <FontFamily x:Key="BrandHeadingFont">avares://Hermaeus.Desktop/Assets/Fonts/Cinzel#Cinzel</FontFamily>
        <FontFamily x:Key="BrandBodyFont">avares://Hermaeus.Desktop/Assets/Fonts/SourceSans3#Source Sans 3</FontFamily>
        <FontFamily x:Key="BrandMonoFont">avares://Hermaeus.Desktop/Assets/Fonts/JetBrainsMono#JetBrains Mono</FontFamily>

        <!-- Brand colour palette (docs/mascot.md). -->
        <Color x:Key="BrandDeepMossColor">#2E3D2B</Color>
        <Color x:Key="BrandForestColor">#436B3F</Color>
        <Color x:Key="BrandSageColor">#7A8F6A</Color>
        <Color x:Key="BrandParchmentColor">#E8DFC6</Color>
        <Color x:Key="BrandInkColor">#1A1D18</Color>
        <Color x:Key="BrandCopperColor">#B87333</Color>
        <Color x:Key="BrandAmberColor">#D19A42</Color>
        <Color x:Key="BrandTealColor">#2F6F6D</Color>
        <Color x:Key="BrandIndigoColor">#3D4A6B</Color>
        <Color x:Key="BrandBerryColor">#7B3D5A</Color>
        <SolidColorBrush x:Key="BrandDeepMossBrush" Color="{StaticResource BrandDeepMossColor}" />
        <SolidColorBrush x:Key="BrandForestBrush" Color="{StaticResource BrandForestColor}" />
        <SolidColorBrush x:Key="BrandSageBrush" Color="{StaticResource BrandSageColor}" />
        <SolidColorBrush x:Key="BrandParchmentBrush" Color="{StaticResource BrandParchmentColor}" />
        <SolidColorBrush x:Key="BrandInkBrush" Color="{StaticResource BrandInkColor}" />
        <SolidColorBrush x:Key="BrandCopperBrush" Color="{StaticResource BrandCopperColor}" />
        <SolidColorBrush x:Key="BrandAmberBrush" Color="{StaticResource BrandAmberColor}" />
        <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
        <SolidColorBrush x:Key="BrandIndigoBrush" Color="{StaticResource BrandIndigoColor}" />
        <SolidColorBrush x:Key="BrandBerryBrush" Color="{StaticResource BrandBerryColor}" />

        <!-- FluentTheme accent overrides so default accent-styled controls
             (ToggleSwitch, CheckBox, default-accent buttons) pick up the brand
             green/copper instead of Avalonia's default blue. -->
        <Color x:Key="SystemAccentColor">#436B3F</Color>
        <Color x:Key="SystemAccentColorDark1">#2E3D2B</Color>
        <Color x:Key="SystemAccentColorDark2">#232E20</Color>
        <Color x:Key="SystemAccentColorDark3">#1A1D18</Color>
        <Color x:Key="SystemAccentColorLight1">#5C8154</Color>
        <Color x:Key="SystemAccentColorLight2">#7A8F6A</Color>
        <Color x:Key="SystemAccentColorLight3">#A3B497</Color>
    </Application.Resources>
</Application>
