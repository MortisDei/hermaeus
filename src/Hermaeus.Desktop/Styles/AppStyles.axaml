<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global defaults - minimal to avoid breaking local layouts -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandBodyFont}" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandHeadingFont}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style Selector="Border.settings-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
    </Style>

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <Style Selector="ListBoxItem.conv-item">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── Chat input ───────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- AcceptsReturn is set dynamically in ChatView.axaml.cs based on
             Ui.CtrlEnterToSend: hardcoding it true here would make Avalonia's
             own newline-insertion swallow a plain Enter before the app's send
             handler ever sees it, regardless of the setting. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── Icon buttons ─────────────────────────────────────────────────── -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Send / Stop button ───────────────────────────────────────────── -->
    <!-- "Primary button" per docs/mascot.md brand palette: Forest fill, Parchment text. -->
    <Style Selector="Button.send-btn">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>
    <Style Selector="Button.send-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandDeepMossBrush}" />
    </Style>

    <!-- ── Sidebar new-chat button ──────────────────────────────────────── -->
    <!-- "Secondary button" per docs/mascot.md brand palette: Forest outline, no fill. -->
    <Style Selector="Button.sidebar-new">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForestBrush}" />
    </Style>
    <Style Selector="Button.sidebar-new:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>

    <!-- ── Code block ───────────────────────────────────────────────────── -->
    <Style Selector="Border.code-block">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ── Sidebar section header ───────────────────────────────────────── -->
    <Style Selector="TextBlock.sidebar-section-header">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Margin" Value="14,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Streaming pulse ──────────────────────────────────────────────── -->
    <Style Selector="TextBlock.streaming-cursor">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</Styles>
