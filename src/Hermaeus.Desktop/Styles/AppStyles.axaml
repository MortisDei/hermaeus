<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- r22 2.3: branded, theme-aware tooltip surface. FluentTheme's stock
         ToolTip resources are theme-dictionary based and were not actually
         broken, but they sit next to App.axaml's variant-blind SystemAccentColor
         overrides with nothing pinning tooltip contrast in place; these
         explicit brushes remove that dependency. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppToolTipBackgroundBrush" Color="#2E3D2B" />
                    <SolidColorBrush x:Key="AppToolTipForegroundBrush" Color="#E8DFC6" />
                    <SolidColorBrush x:Key="AppToolTipBorderBrush" Color="#66436B3F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppToolTipBackgroundBrush" Color="#E8DFC6" />
                    <SolidColorBrush x:Key="AppToolTipForegroundBrush" Color="#1A1D18" />
                    <SolidColorBrush x:Key="AppToolTipBorderBrush" Color="#66436B3F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Tooltips are drawn by Controls/OverlayToolTip.cs, not by Avalonia's
         ToolTipService. Avalonia shows them in a Popup whose outermost edge
         counts as being over the popup but returns no hit-test result, so the
         service concludes nothing is under the pointer, closes the tooltip, and
         reopens it because the pointer never left the control. That loop
         rewrites TopLevel.PointerOverElement, TopLevel calls SetCursor on every
         change, and the cursor flickers between the control's hand and the
         default arrow - usually without the tooltip ever painting. It is
         upstream AvaloniaUI/Avalonia#19218, still open against 12.0.3 on
         Windows, macOS and Wayland.

         ServiceEnabled false stops that service. ToolTip.Tip is still the
         source of the text and is still what the icon-only-control guard test
         scans for; OverlayToolTip reads the same attached values and renders
         them in the window's OverlayLayer with hit-testing off, so the tooltip
         cannot influence what the pointer is over and the loop has nothing to
         feed on. Four XAML placement and hit-test workarounds were tried before
         this and none held, because none of them removed the popup. -->
    <Style Selector=":is(Control)">
        <Setter Property="ToolTip.ServiceEnabled" Value="False" />
    </Style>

    <Style Selector="Border.app-tooltip">
        <Setter Property="Background" Value="{DynamicResource AppToolTipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolTipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000" />
    </Style>
    <Style Selector="Border.app-tooltip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppToolTipForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- r22 2.2: first-party text-dim classes with a contrast floor. Ad-hoc
         Opacity on text has no floor and each instance is a fresh chance to
         be unreadable in one theme variant; "faint" is the dimmest any
         user-relevant text may go. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Global defaults - minimal to avoid breaking local layouts -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AppHeadingFont}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style Selector="Border.settings-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
    </Style>

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <Style Selector="ListBoxItem.conv-item">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── Chat input ───────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="{DynamicResource AppChatFontSize}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- r29 doc 01 1.4: AcceptsReturn is true always. It used to be set
             dynamically from Ui.CtrlEnterToSend, which left the default
             configuration (setting false) with AcceptsReturn false and no key
             combination that could insert a newline at all. ChatView's
             tunnelling KeyDown handler now decides send vs newline for both
             settings before TextBox's class handler sees the key. -->
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── Icon buttons ─────────────────────────────────────────────────── -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- The base-state Background setters below are what stop the cursor
         flicker, and every ":pointerover /template/ ContentPresenter" style in
         this file needs its matching pair.

         Measured cause: with only a hover setter, the presenter's background
         between hovers came from the template binding, and when the hover
         setter deactivated the presenter stopped being a hit-test result. The
         pointer then fell through to the window's root Panel, which dropped
         :pointerover, which restored the button, which re-hovered it - a two
         state oscillator running at about 80Hz. Every rebuild rewrites
         TopLevel.PointerOverElement and TopLevel calls SetCursor on every such
         change, so the cursor alternated between the button's hand and the
         default arrow. A pointer-event log showed 953 enter/exit pairs on one
         inactive button against 7 on the active one.

         The active nav button never flickered because nav-active sets this
         same presenter background explicitly and unconditionally, so hovering
         it changes nothing. Pinning the base state here gives every button that
         same property: hover swaps one brush for another instead of
         introducing one, and hit-testing never changes.

         The base selector excludes :pointerover, :pressed and :disabled so it
         is mutually exclusive with the hover setter below and with FluentTheme's
         pressed and disabled setters. An earlier version excluded only the last
         two, which left base and hover both matching while hovering; which one
         won then depended on style activation order rather than on anything
         written here, and the hover highlight stopped appearing. Exactly one of
         these selectors matches in any state. -->
    <Style Selector="Button.icon-btn:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Activity rows ────────────────────────────────────────────────── -->
    <!-- The affordance is the row itself, not a new icon column (r28 doc 03
         3.2). A row with nothing to open has IsHitTestVisible false, so it
         never lights up on hover and reads as inert without being greyed. -->
    <Style Selector="Button.activity-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.activity-row:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Send / Stop button ───────────────────────────────────────────── -->
    <!-- "Primary button" per docs/mascot.md brand palette: Forest fill, Parchment text. -->
    <Style Selector="Button.send-btn">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>
    <Style Selector="Button.send-btn:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
    </Style>
    <Style Selector="Button.send-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandDeepMossBrush}" />
    </Style>

    <!-- ── Sidebar new-chat button ──────────────────────────────────────── -->
    <!-- "Secondary button" per docs/mascot.md brand palette: Forest outline, no fill. -->
    <Style Selector="Button.sidebar-new">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForestBrush}" />
    </Style>
    <Style Selector="Button.sidebar-new:not(:pointerover):not(:pressed):not(:disabled) /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sidebar-new:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>

    <!-- ── Code block ───────────────────────────────────────────────────── -->
    <Style Selector="Border.code-block">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ── Sidebar section header ───────────────────────────────────────── -->
    <Style Selector="TextBlock.sidebar-section-header">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Margin" Value="14,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Streaming pulse ──────────────────────────────────────────────── -->
    <Style Selector="TextBlock.streaming-cursor">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</Styles>
