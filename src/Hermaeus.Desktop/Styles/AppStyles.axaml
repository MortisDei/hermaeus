<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- r22 2.3: branded, theme-aware tooltip surface. FluentTheme's stock
         ToolTip resources are theme-dictionary based and were not actually
         broken, but they sit next to App.axaml's variant-blind SystemAccentColor
         overrides with nothing pinning tooltip contrast in place; these
         explicit brushes remove that dependency. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppToolTipBackgroundBrush" Color="#2E3D2B" />
                    <SolidColorBrush x:Key="AppToolTipForegroundBrush" Color="#E8DFC6" />
                    <SolidColorBrush x:Key="AppToolTipBorderBrush" Color="#66436B3F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppToolTipBackgroundBrush" Color="#E8DFC6" />
                    <SolidColorBrush x:Key="AppToolTipForegroundBrush" Color="#1A1D18" />
                    <SolidColorBrush x:Key="AppToolTipBorderBrush" Color="#66436B3F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Avalonia's default ToolTip.Placement is Pointer, so the popup opens
         directly under the cursor. The popup is a separate OS window with its
         own cursor, so the pointer sitting on it shows an arrow while the
         control underneath asks for a hand: the cursor flickers between the two
         as the popup opens, moves and closes. Placing the tooltip away from the
         pointer removes the overlap and with it the flicker. -->
    <!-- r29 1.5, CONFIRMED by the owner's one-button experiment: with
         ToolTip.Tip removed from a nav button, that button stopped flickering.
         The popup is the mechanism, which is why two cursor-region fixes never
         touched it.

         The first attempt at the fix set IsHitTestVisible="False" on the
         ToolTip, and it made things worse. Avalonia's ToolTipService.Update
         walks up from the pointer's hit-test result and returns early when it
         reaches the open tooltip ("if (candidateToolTipHost == currentToolTip)
         return;") - that early return IS the "do not close while the pointer is
         over the tooltip" guard. A hit-test-invisible tooltip yields a null hit
         result, the walk ends immediately, and the service closes the tooltip
         as though the pointer had left everything. It then reopens, because the
         pointer is still on the control. So the setter created an open/close
         loop on top of the cursor flicker instead of removing it.

         What is left is geometry, and geometry is the whole fix: keep the popup
         out from under the pointer.

         Bottom placement suits a control the pointer rests on, and the 10px
         offset keeps the popup off the control's edge. It is wrong for a
         vertical stack, where "below this button" is "on top of the next
         button" and every tooltip lands in the path the cursor takes down the
         rail; MainWindow's nav rail overrides to Right for that reason. -->
    <Style Selector=":is(Control)">
        <Setter Property="ToolTip.Placement" Value="Bottom" />
        <Setter Property="ToolTip.VerticalOffset" Value="10" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppToolTipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppToolTipForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolTipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>

    <!-- r22 2.2: first-party text-dim classes with a contrast floor. Ad-hoc
         Opacity on text has no floor and each instance is a fresh chance to
         be unreadable in one theme variant; "faint" is the dimmest any
         user-relevant text may go. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Global defaults - minimal to avoid breaking local layouts -->
    <Style Selector="Window">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFont}" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource AppHeadingFont}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <Style Selector="Border.settings-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
    </Style>

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <Style Selector="ListBoxItem.conv-item">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── Chat input ───────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="{DynamicResource AppChatFontSize}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- r29 doc 01 1.4: AcceptsReturn is true always. It used to be set
             dynamically from Ui.CtrlEnterToSend, which left the default
             configuration (setting false) with AcceptsReturn false and no key
             combination that could insert a newline at all. ChatView's
             tunnelling KeyDown handler now decides send vs newline for both
             settings before TextBox's class handler sees the key. -->
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── Icon buttons ─────────────────────────────────────────────────── -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Activity rows ────────────────────────────────────────────────── -->
    <!-- The affordance is the row itself, not a new icon column (r28 doc 03
         3.2). A row with nothing to open has IsHitTestVisible false, so it
         never lights up on hover and reads as inert without being greyed. -->
    <Style Selector="Button.activity-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.activity-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Send / Stop button ───────────────────────────────────────────── -->
    <!-- "Primary button" per docs/mascot.md brand palette: Forest fill, Parchment text. -->
    <Style Selector="Button.send-btn">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>
    <Style Selector="Button.send-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandDeepMossBrush}" />
    </Style>

    <!-- ── Sidebar new-chat button ──────────────────────────────────────── -->
    <!-- "Secondary button" per docs/mascot.md brand palette: Forest outline, no fill. -->
    <Style Selector="Button.sidebar-new">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForestBrush}" />
    </Style>
    <Style Selector="Button.sidebar-new:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandForestBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrandParchmentBrush}" />
    </Style>

    <!-- ── Code block ───────────────────────────────────────────────────── -->
    <Style Selector="Border.code-block">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ── Sidebar section header ───────────────────────────────────────── -->
    <Style Selector="TextBlock.sidebar-section-header">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Margin" Value="14,6,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Streaming pulse ──────────────────────────────────────────────── -->
    <Style Selector="TextBlock.streaming-cursor">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

</Styles>
