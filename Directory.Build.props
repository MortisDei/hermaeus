<Project>
  <PropertyGroup>
    <VersionPrefix>0.9.2</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <AssemblyVersion>0.9.2.0</AssemblyVersion>
    <FileVersion>0.9.2.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>Aether</Product>
    <Authors>MortisDei</Authors>
    <Company>MortisDei</Company>
    <Copyright>Copyright (c) 2026 MortisDei</Copyright>
    <RepositoryUrl>https://github.com/MortisDei/aether</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MortisDei/aether</PackageProjectUrl>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Description>A native, local-first AI workspace for chat, RAG, local runtimes, and voice workflows.</Description>
    <!-- Treat any compiler warning as an error to enforce zero-warning builds -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
