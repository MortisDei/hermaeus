# Build outputs
**/bin/
**/obj/
**/dist/

# Test run output. A .trx names the machine and the account that ran it
# (runUser="MACHINE\user" in its header), so it must never reach a public
# repo. dotnet test writes here by default whenever a logger or a coverage
# collector is passed without an explicit results directory.
**/TestResults/
*.trx
*.coverage
*.cobertura.xml

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code (launch.json/tasks.json are shared repo config, tracked on purpose)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# NuGet
*.nupkg
# Rider
.idea/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Python / Oghma sidecar artifacts
__pycache__/
*.pyc

# Large LLM model files
*.gguf
*.bin
*.pth
*.pt

# Local secrets
local.settings.json
secrets.json

# Misc
*.pid
*.seed

# Node
node_modules/

# Temporary
*.tmp
*.temp
temp/
*/temp

# C# Dev Kit Shit
*.lscache

# Other
CLAUDE.md