{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Desktop)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Hermaeus.Desktop/bin/Debug/net10.0/Hermaeus.Desktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hermaeus.Desktop",
            "stopAtEntry": false,
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": ".NET Core Launch (Desktop, Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (Release)",
            "program": "${workspaceFolder}/src/Hermaeus.Desktop/bin/Release/net10.0/Hermaeus.Desktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Hermaeus.Desktop",
            "stopAtEntry": false,
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
